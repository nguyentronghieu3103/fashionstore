                ]
            },
            {
                code: "NV-02",
                name: "Vũ Minh Hiếu",
                email: "hieu.vu@lightlife.vn",
                phone: "0912.345.678",
                role: "Staff",
                counter: "Quầy chính",
                status: "active",
                color: "#8b5cf6",
                hasOpenShift: true,
                session: "Máy POS Quầy chính (Chrome 128 - Windows)",
                sessionIp: "IP: 192.168.1.45 · Đăng nhập lúc: 15:30",
                history: [
                    { time: "08/10/2026 15:30", actor: "Vũ Minh Hiếu", action: "Nhận ca chiều 15:30" },
                    { time: "05/10/2026 14:00", actor: "Admin", action: "Đổi phân công sang Quầy chính" }
                ]
            },
            {
                code: "NV-03",
                name: "Đỗ Thị Yến",
                email: "yen.do@lightlife.vn",
                phone: "0988.765.432",
                role: "Staff",
                counter: "Quầy phụ 2",
                status: "active",
                color: "#ec4899",
                hasOpenShift: false,
                session: "Điện thoại cá nhân (Safari - iOS)",
                sessionIp: "IP: 113.161.42.12 · Đăng nhập lúc: 10:20",
                history: [
                    { time: "07/10/2026 22:15", actor: "Admin", action: "Giải trình lệch tiền ca tối" },
                    { time: "02/10/2026 10:00", actor: "Admin", action: "Tạo tài khoản vai trò Nhân viên" }
                ]
            },
            {
                code: "KH-1042",
                name: "Nguyễn Thu Thủy",
                email: "thuthuy.nguyen@gmail.com",
                phone: "0934.888.777",
                role: "Customer",
                counter: "Không áp dụng",
                status: "active",
                color: "#6b7280",
                hasOpenShift: false,
                session: "Web Khách hàng (Chrome - Android)",
                sessionIp: "IP: 14.162.88.90 · Đăng nhập lúc: 11:45",
                history: [
                    { time: "06/10/2026 11:30", actor: "Khách hàng", action: "Đăng ký tài khoản công khai H06" }
                ]
            }
        ];

        var selectedAccountCode = "NV-01";
        var selectedRoleValue = "Staff";

        document.addEventListener('DOMContentLoaded', function () {
            renderAccountList();
            loadAccountDetail(selectedAccountCode);
        });

        function renderAccountList() {
            var container = document.getElementById('accountListContainer');
            var kw = (document.getElementById('accSearchInput') ? document.getElementById('accSearchInput').value : '').toLowerCase().trim();
            var roleFilter = document.getElementById('accRoleFilter') ? document.getElementById('accRoleFilter').value : '';

            var filtered = accountsData.filter(function (acc) {
                var matchKw = (kw === '' || acc.name.toLowerCase().includes(kw) || acc.code.toLowerCase().includes(kw) || acc.email.toLowerCase().includes(kw));
                var matchRole = (roleFilter === '' || acc.role === roleFilter);
                return matchKw && matchRole;
            });

            document.getElementById('totalAccountCount').innerText = filtered.length;

            if (filtered.length === 0) {
                container.innerHTML = '<div class="text-center text-muted py-4 small">Không tìm thấy tài khoản phù hợp.</div>';
                return;
            }

            var html = '';
            filtered.forEach(function (acc) {
                var isActive = (acc.code === selectedAccountCode);
                var initials = acc.name.split(' ').slice(-1)[0][0];

                var roleTag = '';
                if (acc.role === 'Admin') roleTag = '<span class="role-badge-admin">Admin</span>';
                else if (acc.role === 'Staff') roleTag = '<span class="role-badge-staff">Nhân viên</span>';
                else roleTag = '<span class="role-badge-customer">Khách hàng</span>';

                var statusTag = acc.status === 'active' ? 
                    '<span class="status-badge-active">Hoạt động</span>' : 
                    '<span class="status-badge-locked">Bị khóa</span>';

                html += `
                    <div class="list-group-item account-item-row p-3 ${isActive ? 'active' : ''}" onclick="loadAccountDetail('${acc.code}')">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle-sm text-white" style="background-color: ${acc.color};">
                                    ${initials}
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">${acc.name}</div>
                                    <div class="text-muted font-monospace" style="font-size: 0.75rem;">${acc.code} · ${acc.email}</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="mb-1">${roleTag}</div>
                                <div>${statusTag}</div>
                            </div>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function filterAccountList() {
            renderAccountList();
        }

        function loadAccountDetail(code) {
            selectedAccountCode = code;
            var acc = accountsData.find(function (a) { return a.code === code; });
            if (!acc) return;

            renderAccountList();

            var initials = acc.name.split(' ').slice(-1)[0][0];
            var avatarEl = document.getElementById('dAvatarCircle');
            avatarEl.innerText = initials;
            avatarEl.style.backgroundColor = acc.color;

            document.getElementById('dFullName').innerText = acc.name;
            document.getElementById('dCode').innerText = acc.code;
            document.getElementById('dEmail').innerText = acc.email;

            var rBadge = document.getElementById('dRoleBadge');
            if (acc.role === 'Admin') {
                rBadge.className = 'role-badge-admin';
                rBadge.innerText = 'Admin';
            } else if (acc.role === 'Staff') {
                rBadge.className = 'role-badge-staff';
                rBadge.innerText = 'Nhân viên';
            } else {
                rBadge.className = 'role-badge-customer';
                rBadge.innerText = 'Khách hàng';
            }

            var sBadge = document.getElementById('dStatusBadge');
            if (acc.status === 'active') {
                sBadge.className = 'status-badge-active';
                sBadge.innerText = 'Hoạt động';
            } else {
                sBadge.className = 'status-badge-locked';
                sBadge.innerText = 'Bị khóa';
            }

            var btnLock = document.getElementById('btnToggleLock');
            if (acc.role === 'Admin') {
                btnLock.disabled = true;
                btnLock.className = 'btn btn-outline-secondary btn-sm px-3';
                btnLock.innerHTML = '<i class="fa-solid fa-shield-halved me-1"></i> Admin';
            } else if (acc.status === 'active') {
                btnLock.disabled = false;
                btnLock.className = 'btn btn-outline-danger btn-sm px-3';
                btnLock.innerHTML = '<i class="fa-solid fa-lock me-1"></i> Khóa tài khoản';
            } else {
                btnLock.disabled = false;
                btnLock.className = 'btn btn-outline-success btn-sm px-3';
                btnLock.innerHTML = '<i class="fa-solid fa-lock-open me-1"></i> Mở khóa tài khoản';
            }

            document.getElementById('fCode').value = acc.code;
            document.getElementById('fFullName').value = acc.name;
            document.getElementById('fEmail').value = acc.email;
            document.getElementById('fPhone').value = acc.phone;
            document.getElementById('fCounter').value = acc.counter;
            document.getElementById('fStatus').value = acc.status;

            var counterContainer = document.getElementById('fCounterContainer');
            if (acc.role === 'Customer') {
                counterContainer.style.display = 'none';
            } else {
                counterContainer.style.display = 'block';
            }

            var adminNotice = document.getElementById('adminNoticeBlock');
            var roleRow = document.getElementById('roleSelectorRow');
            if (acc.role === 'Admin') {
                adminNotice.classList.remove('d-none');
                roleRow.style.opacity = '0.5';
                roleRow.style.pointerEvents = 'none';
            } else {
                adminNotice.classList.add('d-none');
                roleRow.style.opacity = '1';
                roleRow.style.pointerEvents = 'auto';
                selectRole(acc.role);
            }

            document.getElementById('fNewPassword').value = '';
            document.getElementById('dActiveSession').innerText = acc.session;
            document.getElementById('dSessionIp').innerText = acc.sessionIp;

            renderHistoryTable(acc.history);
        }

        function selectRole(role) {
            selectedRoleValue = role;
            var boxStaff = document.getElementById('roleBoxStaff');
            var boxCustomer = document.getElementById('roleBoxCustomer');
            var radioStaff = document.getElementById('radioRoleStaff');
            var radioCustomer = document.getElementById('radioRoleCustomer');
            var counterContainer = document.getElementById('fCounterContainer');

            if (role === 'Staff') {
                boxStaff.classList.add('selected');
                boxCustomer.classList.remove('selected');
                radioStaff.checked = true;
                radioCustomer.checked = false;
                if (counterContainer) counterContainer.style.display = 'block';
            } else {
                boxCustomer.classList.add('selected');
                boxStaff.classList.remove('selected');
                radioCustomer.checked = true;
                radioStaff.checked = false;
                if (counterContainer) counterContainer.style.display = 'none';
            }
        }

        function renderHistoryTable(list) {
            var tbody = document.getElementById('historyTableBody');
            if (!list || list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted py-2">Chưa có lịch sử thay đổi.</td></tr>';
                return;
            }
            var html = '';
            list.forEach(function (item) {
                html += `
                    <tr>
                        <td class="font-monospace text-muted">${item.time}</td>
                        <td class="fw-semibold text-dark">${item.actor}</td>
                        <td>${item.action}</td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        function saveAccountChanges() {
            var acc = accountsData.find(function (a) { return a.code === selectedAccountCode; });
            if (!acc) return;

            var newName = document.getElementById('fFullName').value.trim();
            var newEmail = document.getElementById('fEmail').value.trim();
            var newPhone = document.getElementById('fPhone').value.trim();
            var newCounter = document.getElementById('fCounter').value;
            var newStatus = document.getElementById('fStatus').value;

            if (!newName || !newEmail) {
                alert('Vui lòng nhập đầy đủ Họ tên và Email!');
                return;
            }

            var oldRole = acc.role;
            acc.name = newName;
            acc.email = newEmail;
            acc.phone = newPhone;
            acc.counter = (selectedRoleValue === 'Customer' ? 'Không áp dụng' : newCounter);
            acc.status = newStatus;

            if (acc.role !== 'Admin') {
                acc.role = selectedRoleValue;
            }

            var nowStr = new Date().toLocaleString('vi-VN');
            if (oldRole !== acc.role) {
                acc.history.unshift({ time: nowStr, actor: "Admin", action: "Đổi vai trò thành: " + (acc.role === 'Staff' ? 'Nhân viên' : 'Khách hàng') });
            } else {
                acc.history.unshift({ time: nowStr, actor: "Admin", action: "Cập nhật thông tin tài khoản" });
            }

            loadAccountDetail(acc.code);
            alert('🎉 Đã lưu thay đổi tài khoản ' + acc.code + ' thành công!');
        }

        function toggleAccountLock() {
            var acc = accountsData.find(function (a) { return a.code === selectedAccountCode; });
            if (!acc || acc.role === 'Admin') return;

            if (acc.status === 'active') {
                if (acc.hasOpenShift) {
                    alert('⚠️ NGOẠI LỆ NGHIỆP VỤ:\n\nNhân viên ' + acc.name + ' hiện đang có ca trực đang mở!\nYêu cầu bàn giao kết ca trước khi khóa tài khoản.');
                    return;
                }

                if (!confirm('Xác nhận KHÓA TÀI KHOẢN ' + acc.name + ' (' + acc.code + ')?')) return;

                acc.status = 'locked';
                acc.session = 'Đã thu hồi phiên';
                acc.sessionIp = '--';
                acc.history.unshift({ time: new Date().toLocaleString('vi-VN'), actor: "Admin", action: "Khóa tài khoản" });
                alert('Đã khóa tài khoản ' + acc.code + ' thành công!');
            } else {
                if (!confirm('Xác nhận MỞ KHÓA TÀI KHOẢN cho ' + acc.name + '?')) return;
                acc.status = 'active';
                acc.history.unshift({ time: new Date().toLocaleString('vi-VN'), actor: "Admin", action: "Mở khóa tài khoản" });
                alert('Đã mở khóa tài khoản ' + acc.code + ' thành công!');
            }

            loadAccountDetail(acc.code);
        }

        function resetPasswordAction() {
            var acc = accountsData.find(function (a) { return a.code === selectedAccountCode; });
            var pass = document.getElementById('fNewPassword').value.trim();
            if (!pass) {
                alert('Vui lòng nhập mật khẩu mới trước khi bấm cập nhật!');
                document.getElementById('fNewPassword').focus();
                return;
            }

            if (!confirm('Xác nhận đặt lại mật khẩu mới cho tài khoản ' + acc.name + '?')) return;

            document.getElementById('fNewPassword').value = '';
            acc.history.unshift({ time: new Date().toLocaleString('vi-VN'), actor: "Admin", action: "Đặt lại mật khẩu mới" });
            renderHistoryTable(acc.history);
            alert('Đã đổi mật khẩu mới thành công cho tài khoản ' + acc.code + '!');
        }

        function revokeSessionAction() {
            var acc = accountsData.find(function (a) { return a.code === selectedAccountCode; });
            if (!confirm('Thu hồi phiên đăng nhập hiện tại của ' + acc.name + '?')) return;

            acc.session = 'Chưa có phiên nào (Đã thu hồi)';
            acc.sessionIp = '--';
            acc.history.unshift({ time: new Date().toLocaleString('vi-VN'), actor: "Admin", action: "Thu hồi phiên đăng nhập" });
            loadAccountDetail(acc.code);
            alert('Đã thu hồi phiên đăng nhập thành công!');
        }

        function openCreateAccount() {
            var nextId = "NV-0" + (accountsData.filter(function(a){return a.role === 'Staff';}).length + 1);
            document.getElementById('newCode').value = nextId;
            document.getElementById('newName').value = '';
            document.getElementById('newEmail').value = '';
            document.getElementById('newPhone').value = '';
            new bootstrap.Modal(document.getElementById('createAccountModal')).show();
        }

        function submitCreateAccount() {
            var code = document.getElementById('newCode').value.trim();
            var name = document.getElementById('newName').value.trim();
            var email = document.getElementById('newEmail').value.trim();
            var phone = document.getElementById('newPhone').value.trim() || '0900.000.000';
            var counter = document.getElementById('newCounter').value;

            if (!code || !name || !email) {
                alert('Vui lòng điền đầy đủ Mã, Họ tên và Email!');
                return;
            }

            var newAcc = {
                code: code,
                name: name,
                email: email,
                phone: phone,
                role: "Staff",
                counter: counter,
                status: "active",
                color: "#10b981",
                hasOpenShift: false,
                session: "Chưa đăng nhập lần đầu",
                sessionIp: "--",
                history: [
                    { time: new Date().toLocaleString('vi-VN'), actor: "Admin", action: "Tạo mới tài khoản nhân viên" }
                ]
            };

            accountsData.push(newAcc);
            bootstrap.Modal.getInstance(document.getElementById('createAccountModal')).hide();
            selectedAccountCode = newAcc.code;
            renderAccountList();
            loadAccountDetail(newAcc.code);

            alert('🎉 Đã tạo thành công tài khoản Nhân viên: ' + newAcc.name + ' (' + newAcc.code + ')');
        }
    </script>
}

