<!-- MODAL: Thêm khách hàng mới (Kiểm tra tránh trùng SĐT theo ngoại lệ PDF) -->
<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header border-bottom p-3">
                <h6 class="modal-title fw-bold text-dark">Thêm hồ sơ khách hàng mới</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark">Họ và tên khách hàng</label>
                    <input type="text" class="form-control form-control-sm" id="newCustName" placeholder="Ví dụ: Hoàng Bích Phương" required />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-dark">Số điện thoại (*)</label>
                        <input type="text" class="form-control form-control-sm font-monospace" id="newCustPhone" placeholder="09xxxxxxxx" required onblur="checkDuplicatePhone(this.value)" />
                        <small class="text-danger d-none" id="phoneDupAlert" style="font-size: 0.72rem;">⚠️ Số điện thoại đã tồn tại trong hệ thống!</small>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-dark">Email (Tùy chọn)</label>
                        <input type="email" class="form-control form-control-sm" id="newCustEmail" placeholder="email@@example.com" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark">Địa chỉ giao hàng</label>
                    <input type="text" class="form-control form-control-sm" id="newCustAddress" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold text-dark">Ghi chú form dáng & sở thích thời trang</label>
                    <textarea class="form-control form-control-sm" id="newCustNote" rows="2" placeholder="Ví dụ: Thích đầm dáng dài, chuộng màu pastel, size L..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top p-3">
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-dark btn-sm px-3" onclick="saveNewCustomer()">Lưu hồ sơ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Danh sách số điện thoại đã tồn tại để kiểm tra ngoại lệ: "Điện thoại đã tồn tại: gợi ý hồ sơ cũ"
        var existingPhones = ['0903124567', '0918332981', '0987654321', '0933881224', '0909999111'];

        function checkDuplicatePhone(phone) {
            var cleanPhone = phone.replace(/\s+/g, '');
            var alertEl = document.getElementById('phoneDupAlert');
            if (cleanPhone && existingPhones.includes(cleanPhone)) {
                alertEl.classList.remove('d-none');
            } else {
                alertEl.classList.add('d-none');
            }
        }

        var selectedCustId = 1;

        // Xem hồ sơ khách hàng
        function viewCustomerProfile(id, name, phone, email, address, tier, totalSpent, ordersCount, points, notes) {
            selectedCustId = id;
            document.getElementById('modalCustName').innerText = name;
            document.getElementById('modalCustPhone').innerText = phone;
            document.getElementById('modalCustEmail').innerText = email;
            document.getElementById('modalCustAddress').innerText = address;
            document.getElementById('modalCustTier').innerText = tier;
            document.getElementById('modalCustTotalSpent').innerText = totalSpent;
            document.getElementById('modalCustNotes').innerText = notes;
            document.getElementById('modalCustId').innerText = 'KH-00' + id;

            var initials = name.split(' ').map(function(n) { return n[0]; }).join('').toUpperCase();
            if (initials.length > 2) initials = initials.substring(0, 2);
            document.getElementById('modalCustAvatar').innerText = initials;

            var modal = new bootstrap.Modal(document.getElementById('customerProfileModal'));
            modal.show();
        }

        // Khóa / Mở khóa tài khoản khách hàng (Ngoại lệ: "Không xóa khách làm mất liên kết hóa đơn; có thể khóa hồ sơ")
        function toggleCustomerLock(rowId, name, isCurrentlyActive) {
            var row = document.getElementById(rowId);
            if (!row) return;

            if (isCurrentlyActive) {
                if (confirm('Xác nhận KHÓA hồ sơ khách hàng: "' + name + '"?\n\nLưu ý: Hồ sơ bị khóa sẽ không thể tích điểm hay tạo đơn mới tại quầy, nhưng toàn bộ lịch sử hóa đơn cũ vẫn được bảo lưu.')) {
                    updateCustomerStatus(row, false, name);
                }
            } else {
                if (confirm('Kích hoạt MỞ KHÓA hồ sơ khách hàng: "' + name + '"?')) {
                    updateCustomerStatus(row, true, name);
                }
            }
        }

        function updateCustomerStatus(row, isActive, name) {
            row.setAttribute('data-status', isActive ? 'active' : 'locked');

            var badge = row.querySelector('.cust-status-badge');
            if (badge) {
                if (isActive) {
                    badge.className = 'badge bg-success-subtle text-success border border-success-subtle cust-status-badge';
                    badge.innerText = 'Hoạt động';
                } else {
                    badge.className = 'badge bg-secondary-subtle text-secondary border cust-status-badge';
                    badge.innerText = 'Đã khóa';
                }
            }

            var btn = row.querySelector('.toggle-cust-btn');
            if (btn) {
                var rowId = row.id;
                if (isActive) {
                    btn.className = 'btn btn-light btn-sm text-danger border px-2 py-1 toggle-cust-btn';
                    btn.title = 'Khóa hồ sơ';
                    btn.innerHTML = '<i class="fa-solid fa-user-lock"></i>';
                    btn.onclick = function() { toggleCustomerLock(rowId, name, true); };
                } else {
                    btn.className = 'btn btn-light btn-sm text-success border px-2 py-1 toggle-cust-btn';
                    btn.title = 'Mở khóa hồ sơ';
                    btn.innerHTML = '<i class="fa-solid fa-lock-open"></i>';
                    btn.onclick = function() { toggleCustomerLock(rowId, name, false); };
                }
            }
        }

        // Lọc danh sách khách hàng
        function filterCustomers() {
            var kw = document.getElementById('custSearchInput').value.toLowerCase().trim();
            var grp = document.getElementById('custGroupFilter').value;
            var st = document.getElementById('custStatusFilter').value;

            var rows = document.querySelectorAll('#customerTableBody tr');
            var visible = 0;

            rows.forEach(function(row) {
                var rowGrp = row.getAttribute('data-group') || '';
                var rowSt = row.getAttribute('data-status') || '';
                var text = row.innerText.toLowerCase();

                var matchKw = (kw === '' || text.includes(kw));
                var matchGrp = (grp === '' || rowGrp.includes(grp));
                var matchSt = (st === '' || rowSt === st);

                if (matchKw && matchGrp && matchSt) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('visibleCustCount').innerText = visible;
        }

        function resetCustomerFilter() {
            document.getElementById('custSearchInput').value = '';
            document.getElementById('custGroupFilter').value = '';
            document.getElementById('custStatusFilter').value = '';
            filterCustomers();
        }

        // Thêm khách hàng mới
        function openCreateCustomerModal() {
            var modal = new bootstrap.Modal(document.getElementById('createCustomerModal'));
            modal.show();
        }

        function saveNewCustomer() {
            var name = document.getElementById('newCustName').value.trim();
            var phone = document.getElementById('newCustPhone').value.trim();

            if (!name || !phone) {
                alert('Vui lòng nhập Họ tên và Số điện thoại khách hàng!');
                return;
            }

            var cleanPhone = phone.replace(/\s+/g, '');
            if (existingPhones.includes(cleanPhone)) {
                if (!confirm('Số điện thoại ' + phone + ' đã tồn tại trong hệ thống. Bạn có muốn tiếp tục lưu hay kiểm tra lại hồ sơ cũ?')) {
                    return;
                }
            }

            alert('Đã tạo thành công hồ sơ khách hàng mới: ' + name + ' (' + phone + ')!');
            bootstrap.Modal.getInstance(document.getElementById('createCustomerModal')).hide();
        }

        function editCustomerInfo() {
            window.location.href = '@Url.Action("Edit", "Customers", new { area = "Admin" })/' + selectedCustId;
        }

        function exportCustomerData() {
            alert('Đang trích xuất toàn bộ dữ liệu khách hàng theo quyền quản trị viên Admin...');
        }
    </script>
}

