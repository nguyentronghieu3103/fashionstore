@{
    ViewData["Title"] = "Khách hàng & Lịch sử mua";
}

@section Styles {
    <style>
        .customer-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #18181b;
            color: #c5a880;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            border: 1px solid #c5a880;
        }

        .customer-table thead th {
            background: #fafafa;
            color: #6b7280;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .customer-table tbody td {
            padding: 1rem 1.25rem;
            vertical-align: middle;
            font-size: 0.9rem;
            border-bottom: 1px solid #f3f4f6;
        }

        .customer-table tbody tr:hover {
            background-color: #fafafa;
        }

        .filter-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 1rem 1.25rem;
        }

        .badge-vip {
            background: linear-gradient(135deg, rgba(197, 168, 128, 0.2) 0%, rgba(179, 147, 105, 0.1) 100%);
            color: #8c6b3e;
            border: 1px solid rgba(197, 168, 128, 0.4);
            font-weight: 600;
            font-size: 0.72rem;
            padding: 2px 7px;
            border-radius: 4px;
        }

        .badge-loyal {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            font-weight: 600;
            font-size: 0.72rem;
            padding: 2px 7px;
            border-radius: 4px;
        }

        .history-table th {
            font-size: 0.75rem;
            font-weight: 600;
            color: #6b7280;
            background: #f9fafb;
            padding: 0.65rem 0.75rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .history-table td {
            padding: 0.65rem 0.75rem;
            font-size: 0.85rem;
            vertical-align: middle;
            border-bottom: 1px solid #f3f4f6;
        }
    </style>
}

<div class="container-fluid p-0">

    <!-- 1. Khung đầu: Tiêu đề, Tổng khách & Thao tác Admin -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h4 class="fw-bold mb-1 text-dark">Khách hàng và lịch sử mua</h4>
            <div class="text-muted small">Tra cứu hồ sơ khách hàng, phân hạng thành viên và toàn bộ lịch sử chi tiêu (Tổng số: <strong class="text-dark" id="totalCustomerCount">1.240 khách hàng</strong>)</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark btn-sm px-3 d-inline-flex align-items-center gap-2" onclick="exportCustomerData()">
                <i class="fa-solid fa-file-export"></i>
                <span>Xuất danh sách </span>
            </button>
            <button class="btn btn-dark btn-sm px-3 d-inline-flex align-items-center gap-2" onclick="openCreateCustomerModal()">
                <i class="fa-solid fa-user-plus"></i>
                <span>Thêm khách hàng</span>
            </button>
        </div>
    </div>

    <!-- 2. Khung lọc: Tên/SĐT/Email, Nhóm khách, Trạng thái -->
    <div class="filter-card mb-4">
        <div class="row g-2 align-items-center">
            <!-- Tìm tên, SĐT, Email -->
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="custSearchInput" class="form-control border-start-0 ps-1" placeholder="Tìm theo tên, số điện thoại hoặc email..." onkeyup="filterCustomers()" />
                </div>
            </div>

            <!-- Phân nhóm khách hàng -->
            <div class="col-md-3">
                <select id="custGroupFilter" class="form-select form-select-sm" onchange="filterCustomers()">
                    <option value="">Tất cả phân nhóm</option>
                    <option value="VIP">Khách VIP</option>
                    <option value="Thân thiết">Khách Thân thiết</option>
                    <option value="Mới">Khách hàng mới</option>
                </select>
            </div>

            <!-- Trạng thái hồ sơ -->
            <div class="col-md-3">
                <select id="custStatusFilter" class="form-select form-select-sm" onchange="filterCustomers()">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Đang hoạt động</option>
                    <option value="locked">Đã khóa hồ sơ</option>
                </select>
            </div>

            <!-- Đặt lại -->
            <div class="col-md-2 text-md-end">
                <button type="button" class="btn btn-light btn-sm text-secondary w-100" onclick="resetCustomerFilter()">
                    <i class="fa-solid fa-rotate-left me-1"></i> Đặt lại
                </button>
            </div>
        </div>
    </div>

    <!-- 3. Khung bảng: Danh sách khách hàng & Tổng chi tiêu -->
