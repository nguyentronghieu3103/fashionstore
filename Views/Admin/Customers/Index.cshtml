<!-- MODAL: Khung hồ sơ & Lịch sử mua hàng chi tiết [A04 - Profile Drawer] -->
<div class="modal fade" id="customerProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header border-bottom p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="customer-avatar" id="modalCustAvatar">PT</div>
                    <div>
                        <h6 class="modal-title fw-bold text-dark mb-0" id="modalCustName">Nguyễn Phương Thảo</h6>
                        <span class="badge-vip" id="modalCustTier">VIP Kim Cương</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <!-- Thông tin cơ bản -->
                <div class="row g-2 mb-3 p-2 bg-light rounded border">
                    <div class="col-md-4">
                        <small class="text-muted d-block">Số điện thoại:</small>
                        <strong class="text-dark font-monospace" id="modalCustPhone">0903 124 567</strong>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Email:</small>
                        <span class="text-dark" id="modalCustEmail">thao.nguyen@@gmail.com</span>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block">Tổng chi tiêu tích lũy:</small>
                        <strong class="text-dark font-serif" id="modalCustTotalSpent">38.450.000 ₫</strong>
                    </div>
                    <div class="col-12 mt-2 pt-2 border-top">
                        <small class="text-muted d-block">Địa chỉ nhận hàng mặc định:</small>
                        <span class="text-dark" id="modalCustAddress">124 Nguyễn Huệ, P. Bến Nghé, Q.1, TP.HCM</span>
                    </div>
                    <div class="col-12 mt-1">
                        <small class="text-muted d-block">Ghi chú sở thích & form dáng thời trang:</small>
                        <div class="text-dark fst-italic small" id="modalCustNotes">Ưa chuộng dòng Dạ Tweed và Đầm Satin, size M chuẩn form.</div>
                    </div>
                </div>

                <!-- Lịch sử hóa đơn mua & đổi trả -->
                <h6 class="fw-bold text-dark small mb-2"><i class="fa-solid fa-receipt me-1 text-secondary"></i> Lịch sử hóa đơn giao dịch gần đây</h6>
                <div class="table-responsive border rounded-2">
                    <table class="table history-table mb-0">
                        <thead>
                            <tr>
                                <th>Mã hóa đơn</th>
                                <th>Thời gian</th>
