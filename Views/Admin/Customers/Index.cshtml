                    <tr>
                        <th>Khách hàng</th>
                        <th>Số điện thoại & Email</th>
                        <th>Hạng thành viên</th>
                        <th>Lần mua gần nhất</th>
                        <th>Tổng chi tiêu</th>
                        <th>Số đơn</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="customerTableBody">
