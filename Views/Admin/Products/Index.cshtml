                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <button type="button" class="btn btn-outline-dark btn-sm px-2 py-1 me-1" onclick="viewVariants(3, 'Blazer Silk Suông Form Chuẩn', 'BL-SILK-01', 50, true)" title="Xem biến thể màu/size">
                                <i class="fa-solid fa-boxes-stacked me-1"></i> Biến thể
                            </button>
                            <button type="button" class="btn btn-light btn-sm text-danger border px-2 py-1 toggle-status-btn" onclick="toggleSellStatus('prod-3', 'Blazer Silk Suông', 50, true)" title="Ngừng bán">
                                <i class="fa-solid fa-ban"></i>
                            </button>
                        </td>
                    </tr>

                    <!-- SP 4 -->
                    <tr data-cat="Quần tây & Jeans" data-status="active" id="prod-4">
                        <td>
                            <div class="d-flex align-items-center gap-3">
