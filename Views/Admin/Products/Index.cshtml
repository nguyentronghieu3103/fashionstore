                                </div>
                            </div>
                        </td>
                        <td><span class="font-monospace text-secondary fw-semibold">DL-SATIN-02</span></td>
                        <td><span class="badge-category">Đầm & Váy</span></td>
                        <td><strong class="text-dark">1.450.000 ₫</strong></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="variant-chip">3 SKU</span>
                                <span class="text-muted small">Tồn: <strong class="text-dark">42</strong></span>
                            </div>
                        </td>
                        <td>
