                { color: 'Kem Vani', size: 'M', sku: 'DL-ST02-CRM-M', barcode: '89360020102', stock: 15, price: '1.450.000 ₫', cost: '720.000 ₫' },
                { color: 'Hồng Nude', size: 'M', sku: 'DL-ST02-PNK-M', barcode: '89360020103', stock: 26, price: '1.450.000 ₫', cost: '720.000 ₫' }
            ],
            3: [
                { color: 'Xám Khói', size: 'M', sku: 'BL-SL01-GRY-M', barcode: '89360030101', stock: 20, price: '2.250.000 ₫', cost: '1.100.000 ₫' },
                { color: 'Xám Khói', size: 'L', sku: 'BL-SL01-GRY-L', barcode: '89360030102', stock: 15, price: '2.250.000 ₫', cost: '1.100.000 ₫' },
                { color: 'Đen Titan', size: 'M', sku: 'BL-SL01-BLK-M', barcode: '89360030103', stock: 10, price: '2.250.000 ₫', cost: '1.100.000 ₫' },
                { color: 'Đen Titan', size: 'L', sku: 'BL-SL01-BLK-L', barcode: '89360030104', stock: 5, price: '2.250.000 ₫', cost: '1.100.000 ₫' }
            ],
            4: [
                { color: 'Be Sáng', size: '29', sku: 'QT-PL04-BGE-29', barcode: '89360040101', stock: 12, price: '890.000 ₫', cost: '420.000 ₫' },
                { color: 'Be Sáng', size: '30', sku: 'QT-PL04-BGE-30', barcode: '89360040102', stock: 15, price: '890.000 ₫', cost: '420.000 ₫' },
                { color: 'Đen', size: '30', sku: 'QT-PL04-BLK-30', barcode: '89360040103', stock: 8, price: '890.000 ₫', cost: '420.000 ₫' }
            ],
            5: [
                { color: 'Trắng Sữa', size: 'S', sku: 'SM-LN09-WHT-S', barcode: '89360050101', stock: 10, price: '650.000 ₫', cost: '290.000 ₫' },
                { color: 'Trắng Sữa', size: 'M', sku: 'SM-LN09-WHT-M', barcode: '89360050102', stock: 12, price: '650.000 ₫', cost: '290.000 ₫' },
                { color: 'Xanh Mint', size: 'M', sku: 'SM-LN09-MNT-M', barcode: '89360050103', stock: 6, price: '650.000 ₫', cost: '290.000 ₫' }
            ],
            6: [
                { color: 'Trắng Ngà', size: 'S', sku: 'VR-SM25-IVR-S', barcode: '89360060101', stock: 0, price: '950.000 ₫', cost: '450.000 ₫' },
                { color: 'Trắng Ngà', size: 'M', sku: 'VR-SM25-IVR-M', barcode: '89360060102', stock: 0, price: '950.000 ₫', cost: '450.000 ₫' }
            ]
        };

        var currentSelectedProdId = 1;

        // Xem chi tiết biến thể SKU
        function viewVariants(id, name, code, stock, isSelling) {
            currentSelectedProdId = id;
            document.getElementById('modalProdTitle').innerText = name;
            document.getElementById('modalProdCode').innerText = 'Mã mẫu: ' + code + ' • Tổng tồn kho: ' + stock + ' chiếc';

            var tbody = document.getElementById('variantTableBody');
            var list = variantData[id] || [];
            var html = '';

            list.forEach(function(item) {
                var stockClass = item.stock <= 2 ? (item.stock === 0 ? 'text-danger fw-bold' : 'text-warning-emphasis fw-bold') : 'text-dark';
                html += `
                    <tr>
                        <td><strong>${item.color}</strong></td>
                        <td><span class="badge bg-light text-dark border">${item.size}</span></td>
                        <td><span class="font-monospace text-secondary small">${item.sku}</span></td>
                        <td><span class="font-monospace text-muted small">${item.barcode}</span></td>
                        <td class="text-center ${stockClass}">${item.stock}</td>
                        <td class="text-end fw-semibold">${item.price}</td>
                        <td class="text-end text-primary font-monospace">${item.cost}</td>
                    </tr>
                `;
            });

            tbody.innerHTML = html;

            var btnPause = document.getElementById('modalBtnTogglePause');
            if (isSelling) {
                btnPause.innerText = 'Ngừng kinh doanh mẫu này';
                btnPause.className = 'btn btn-outline-danger btn-sm';
            } else {
                btnPause.innerText = 'Mở bán lại mẫu này';
                btnPause.className = 'btn btn-outline-success btn-sm';
            }

            var editLink = document.getElementById('modalEditLink');
            if (editLink) {
                editLink.href = '/Admin/Products/Edit/' + id;
            }

            var modal = new bootstrap.Modal(document.getElementById('variantModal'));
            modal.show();
        }

        // Chuyển trạng thái Ngừng bán / Đang bán (Quy tắc nghiệp vụ: Cảnh báo nếu còn tồn kho)
        function toggleSellStatus(rowId, prodName, stock, isCurrentlySelling) {
            var row = document.getElementById(rowId);
            if (!row) return;

            if (isCurrentlySelling) {
                // Đang hoạt động -> Admin muốn ngắt (Ngừng bán)
                var msg = 'Xác nhận NGỪNG BÁN sản phẩm: "' + prodName + '"?\n';
                if (stock > 0) {
                    msg += '\n⚠️ CẢNH BÁO NGHIỆP VỤ: Sản phẩm này hiện vẫn còn ' + stock + ' cái trong kho.\nKhi ngừng bán, POS sẽ không cho phép quét bán mới, nhưng dữ liệu hóa đơn cũ vẫn được bảo lưu an toàn.';
                }
                if (confirm(msg)) {
                    updateRowStatus(row, false, prodName, stock);
                }
            } else {
                // Đang ngắt -> Admin muốn mở bán lại
                if (confirm('Kích hoạt MỞ BÁN LẠI cho sản phẩm: "' + prodName + '"?')) {
                    updateRowStatus(row, true, prodName, stock);
                }
            }
        }

        function updateRowStatus(row, isSelling, prodName, stock) {
            row.setAttribute('data-status', isSelling ? 'active' : 'paused');

            // 1. Cập nhật Badge trạng thái
            var badge = row.querySelector('.status-badge');
            if (badge) {
                if (isSelling) {
                    badge.className = 'badge bg-success-subtle text-success border border-success-subtle status-badge';
                    badge.innerText = 'Đang bán';
                } else {
                    badge.className = 'badge bg-secondary-subtle text-secondary border status-badge';
                    badge.innerText = 'Ngừng bán';
                }
            }

            // 2. Chuyển đổi Icon Nút (Ảnh 1: Ban đỏ <---> Ảnh 2: Play xanh lá)
            var btn = row.querySelector('.toggle-status-btn');
            if (btn) {
                var rowId = row.id;
                if (isSelling) {
                    // Đang bán -> Biến thành Ảnh 1: Nút đỏ Ban
                    btn.className = 'btn btn-light btn-sm text-danger border px-2 py-1 toggle-status-btn';
                    btn.title = 'Ngừng bán';
                    btn.innerHTML = '<i class="fa-solid fa-ban"></i>';
                    btn.onclick = function() { toggleSellStatus(rowId, prodName, stock, true); };
                } else {
                    // Đang ngắt -> Biến thành Ảnh 2: Nút xanh Play
                    btn.className = 'btn btn-light btn-sm text-success border px-2 py-1 toggle-status-btn';
                    btn.title = 'Mở bán lại';
                    btn.innerHTML = '<i class="fa-solid fa-play"></i>';
                    btn.onclick = function() { toggleSellStatus(rowId, prodName, stock, false); };
                }
            }
        }

        function handleModalDeactivate() {
            var row = document.getElementById('prod-' + currentSelectedProdId);
            if (row) {
                var isSelling = row.getAttribute('data-status') === 'active';
                toggleSellStatus('prod-' + currentSelectedProdId, document.getElementById('modalProdTitle').innerText, 10, isSelling);
                bootstrap.Modal.getInstance(document.getElementById('variantModal')).hide();
            }
        }

        // Lọc danh sách
        function applyFilter() {
            var kw = document.getElementById('filterKeyword').value.toLowerCase().trim();
            var cat = document.getElementById('filterCategory').value;
            var st = document.getElementById('filterStatus').value;

            var rows = document.querySelectorAll('#productTableBody tr');
            var visible = 0;

            rows.forEach(function(row) {
                var rowCat = row.getAttribute('data-cat') || '';
                var rowSt = row.getAttribute('data-status') || '';
                var text = row.innerText.toLowerCase();

                var matchKw = (kw === '' || text.includes(kw));
                var matchCat = (cat === '' || rowCat === cat);
                var matchSt = (st === '' || rowSt === st);

                if (matchKw && matchCat && matchSt) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('visibleCount').innerText = visible;
        }

        function resetFilter() {
            document.getElementById('filterKeyword').value = '';
            document.getElementById('filterCategory').value = '';
            document.getElementById('filterStatus').value = '';
            applyFilter();
        }

        // Modal tạo sản phẩm
        function openCreateProductModal() {
            var modal = new bootstrap.Modal(document.getElementById('createProductModal'));
            modal.show();
        }

        function saveNewProduct() {
            var name = document.getElementById('newProdName').value;
            var code = document.getElementById('newProdCode').value;
            if (!name || !code) {
                alert('Vui lòng nhập đầy đủ tên và mã mẫu sản phẩm!');
                return;
            }
            alert('Đã tạo mẫu sản phẩm: ' + name + ' (' + code + ') thành công!\nCác biến thể S/M/L/XL đã được khởi tạo tự động theo chuẩn A03.');
            bootstrap.Modal.getInstance(document.getElementById('createProductModal')).hide();
        }

        function editProductA03() {
            alert('Điều hướng sang màn hình A03 • Tạo / sửa sản phẩm và biến thể cho mẫu này.');
        }

        function exportProductList() {
            alert('Đang trích xuất danh sách sản phẩm và tồn kho theo quyền hạn Admin...');
        }
    </script>
}

