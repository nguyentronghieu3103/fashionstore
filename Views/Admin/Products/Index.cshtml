                                </div>
                            </div>
                        </td>
                        <td><span class="font-monospace text-secondary fw-semibold">QT-PLEAT-04</span></td>
                        <td><span class="badge-category">Quần tây & Jeans</span></td>
                        <td><strong class="text-dark">890.000 ₫</strong></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="variant-chip">3 SKU</span>
                                <span class="text-muted small">Tồn: <strong class="text-dark">35</strong></span>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle status-badge">Đang bán</span>
                        </td>
                        <td class="text-end">
                            <a href="/Admin/Products/Edit/4" class="btn btn-outline-dark btn-sm px-2 py-1 me-1" title="Chỉnh sửa sản phẩm [A03]">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <button type="button" class="btn btn-outline-dark btn-sm px-2 py-1 me-1" onclick="viewVariants(4, 'Quần Tây Pleated Dáng Suông', 'QT-PLEAT-04', 35, true)" title="Xem biến thể màu/size">
                                <i class="fa-solid fa-boxes-stacked me-1"></i> Biến thể
                            </button>
                            <button type="button" class="btn btn-light btn-sm text-danger border px-2 py-1 toggle-status-btn" onclick="toggleSellStatus('prod-4', 'Quần Tây Pleated', 35, true)" title="Ngừng bán">
                                <i class="fa-solid fa-ban"></i>
                            </button>
                        </td>
                    </tr>

                    <!-- SP 5 -->
                    <tr data-cat="Áo sơ mi" data-status="active" id="prod-5">
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="https://images.unsplash.com/photo-1602810318383-e386cc2a3ccf?w=100&q=80" class="product-thumb" alt="Áo Linen" />
                                <div>
                                    <div class="fw-bold text-dark">Áo Sơ Mi Linen Form Rộng</div>
                                    <small class="text-muted">Chất liệu: 100% sợi Linen tự nhiên</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="font-monospace text-secondary fw-semibold">SM-LINEN-09</span></td>
                        <td><span class="badge-category">Áo sơ mi</span></td>
                        <td><strong class="text-dark">650.000 ₫</strong></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="variant-chip">3 SKU</span>
                                <span class="text-muted small">Tồn: <strong class="text-dark">28</strong></span>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle status-badge">Đang bán</span>
                        </td>
