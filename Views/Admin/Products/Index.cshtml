                            <button type="button" class="btn btn-light btn-sm text-danger border px-2 py-1 toggle-status-btn" onclick="toggleSellStatus('prod-2', 'Đầm Lụa Satin Kem', 42, true)" title="Ngừng bán">
                                <i class="fa-solid fa-ban"></i>
