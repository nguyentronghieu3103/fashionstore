                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <button type="button" class="btn btn-outline-dark btn-sm px-2 py-1 me-1" onclick="viewVariants(6, 'Váy Ren Vintage Mùa Hè', 'VR-SUMMER-25', 0, false)" title="Xem biến thể màu/size">
