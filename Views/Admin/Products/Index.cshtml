</div>

<!-- MODAL: Khung chi tiết nhanh biến thể SKU (Màu - Size - Tồn - Giá vốn theo quyền Admin) -->
<div class="modal fade" id="variantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header border-bottom p-3">
                <div>
                    <h6 class="modal-title fw-bold text-dark mb-0" id="modalProdTitle">Chi tiết biến thể SKU</h6>
                    <small class="text-muted" id="modalProdCode">Mã mẫu: --</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <!-- Bảng SKU -->
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="bg-light text-muted small">
                            <tr>
                                <th>Màu sắc</th>
                                <th>Kích thước</th>
                                <th>Mã SKU</th>
                                <th>Mã Barcode</th>
                                <th class="text-center">Tồn khả dụng</th>
                                <th class="text-end">Giá bán</th>
                                <th class="text-end text-primary" title="Chỉ Admin xem được giá vốn">Giá vốn (Admin)</th>
                            </tr>
                        </thead>
                        <tbody id="variantTableBody">
                            <!-- Nạp động bằng JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-top p-3 d-flex justify-content-between">
                <div>
                    <button type="button" class="btn btn-outline-danger btn-sm" id="modalBtnTogglePause" onclick="handleModalDeactivate()">
                        Ngừng kinh doanh mẫu này
                    </button>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <a id="modalEditLink" href="/Admin/Products/Edit/1" class="btn btn-dark btn-sm">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Chỉnh sửa sản phẩm 
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: Tạo sản phẩm mới [A03] -->
<div class="modal fade" id="createProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header border-bottom p-3">
                <h6 class="modal-title fw-bold text-dark">Thêm mẫu sản phẩm mới [A03]</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div class="mb-3">
                    <label class="form-label small text-muted">Tên mẫu sản phẩm</label>
                    <input type="text" class="form-control form-control-sm" id="newProdName" placeholder="Ví dụ: Đầm Dạ Hội Silk Velvet..." />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Mã mẫu (Duy nhất)</label>
                        <input type="text" class="form-control form-control-sm font-monospace text-uppercase" id="newProdCode" placeholder="DH-SILK-01" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Danh mục</label>
                        <select class="form-select form-select-sm" id="newProdCat">
                            <option value="Đầm & Váy">Đầm & Váy</option>
                            <option value="Áo khoác & Blazer">Áo khoác & Blazer</option>
                            <option value="Áo sơ mi">Áo sơ mi</option>
                            <option value="Quần tây & Jeans">Quần tây & Jeans</option>
                        </select>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Giá bán dự kiến</label>
                        <input type="text" class="form-control form-control-sm" id="newProdPrice" placeholder="1.250.000 ₫" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Giá vốn nhập (Bảo mật)</label>
                        <input type="text" class="form-control form-control-sm" id="newProdCost" placeholder="600.000 ₫" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small text-muted">Kích thước mặc định sinh biến thể</label>
                    <div class="d-flex gap-2">
                        <span class="badge bg-light text-dark border p-2">S</span>
                        <span class="badge bg-light text-dark border p-2">M</span>
                        <span class="badge bg-light text-dark border p-2">L</span>
                        <span class="badge bg-light text-dark border p-2">XL</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top p-3">
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-dark btn-sm px-3" onclick="saveNewProduct()">Tạo mẫu sản phẩm</button>
            </div>
        </div>
    </div>
</div>

