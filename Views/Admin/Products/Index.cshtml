                                    <small class="text-muted">Chất liệu: Cotton pha tơ lụa</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="font-monospace text-secondary fw-semibold">BL-SILK-01</span></td>
                        <td><span class="badge-category">Áo khoác & Blazer</span></td>
                        <td><strong class="text-dark">2.250.000 ₫</strong></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="variant-chip">4 SKU</span>
