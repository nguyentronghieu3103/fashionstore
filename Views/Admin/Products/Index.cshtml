@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

@section Styles {
    <style>
        .product-thumb {
            width: 48px;
            height: 48px;
            border-radius: 8px;
            object-fit: cover;
            border: 1px solid #e5e7eb;
            background: #f9fafb;
        }

        .product-table thead th {
            background: #fafafa;
            color: #6b7280;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .product-table tbody td {
            padding: 1rem 1.25rem;
            vertical-align: middle;
            font-size: 0.9rem;
            border-bottom: 1px solid #f3f4f6;
        }

        .product-table tbody tr:hover {
            background-color: #fafafa;
        }

        .filter-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 1rem 1.25rem;
        }

        .badge-category {
            background: #f3f4f6;
            color: #374151;
            font-weight: 500;
            font-size: 0.78rem;
            padding: 3px 8px;
            border-radius: 4px;
        }

        .variant-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 0.76rem;
            padding: 2px 7px;
            border-radius: 4px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            color: #4b5563;
        }
    </style>
}

<div class="container-fluid p-0">

    <!-- 1. Khung đầu: Tiêu đề, Số mẫu, Nút tạo mới & Xuất -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h4 class="fw-bold mb-1 text-dark">Danh sách sản phẩm</h4>
            <div class="text-muted small">Quản lý mẫu thời trang và biến thể màu - size (Tổng số: <strong class="text-dark" id="totalCount">24 mẫu</strong>)</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark btn-sm px-3 d-inline-flex align-items-center gap-2" onclick="exportProductList()">
                <i class="fa-solid fa-file-export"></i>
                <span>Xuất file</span>
            </button>
            <a href="/Admin/Products/Create" class="btn btn-dark btn-sm px-3 d-inline-flex align-items-center gap-2">
                <i class="fa-solid fa-plus"></i>
                <span>Thêm sản phẩm</span>
            </a>
        </div>
    </div>

    <!-- 2. Khung lọc: Tên/mã, danh mục, trạng thái, mức giá -->
    <div class="filter-card mb-4">
        <div class="row g-2 align-items-center">
            <!-- Tìm tên hoặc mã -->
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="filterKeyword" class="form-control border-start-0 ps-1" placeholder="Tìm theo tên hoặc mã mẫu..." onkeyup="applyFilter()" />
                </div>
            </div>

            <!-- Danh mục -->
            <div class="col-md-3">
                <select id="filterCategory" class="form-select form-select-sm" onchange="applyFilter()">
                    <option value="">Tất cả danh mục</option>
                    <option value="Đầm & Váy">Đầm & Váy</option>
                    <option value="Áo khoác & Blazer">Áo khoác & Blazer</option>
                    <option value="Áo sơ mi">Áo sơ mi</option>
                    <option value="Quần tây & Jeans">Quần tây & Jeans</option>
                </select>
            </div>

            <!-- Trạng thái: Đang bán / Ngừng bán -->
            <div class="col-md-3">
                <select id="filterStatus" class="form-select form-select-sm" onchange="applyFilter()">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Đang bán</option>
                    <option value="paused">Ngừng bán</option>
                </select>
            </div>

            <!-- Đặt lại -->
            <div class="col-md-2 text-md-end">
                <button type="button" class="btn btn-light btn-sm text-secondary w-100" onclick="resetFilter()">
                    <i class="fa-solid fa-rotate-left me-1"></i> Đặt lại
                </button>
            </div>
        </div>
    </div>

    <!-- 3. Khung bảng: Danh sách mẫu sản phẩm -->
    <div class="card border border-1 rounded-3 overflow-hidden shadow-none mb-4">
        <div class="table-responsive">
            <table class="table product-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Mẫu sản phẩm</th>
                        <th>Mã mẫu</th>
                        <th>Danh mục</th>
                        <th>Khoảng giá</th>
                        <th>Biến thể & Tồn</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="productTableBody">
                    <!-- SP 1 -->
                    <tr data-cat="Áo khoác & Blazer" data-status="active" id="prod-1">
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="https://images.unsplash.com/photo-1591047139829-d91aecb6caea?w=100&q=80" class="product-thumb" alt="Áo Tweed" />
                                <div>
                                    <div class="fw-bold text-dark">Áo Tweed Thu Đông Cổ Điển</div>
                                    <small class="text-muted">Chất liệu: Dạ tweed dệt kim</small>
                                </div>
                            </div>
                        </td>
                        <td><span class="font-monospace text-secondary fw-semibold">AT-TWEED-01</span></td>
                        <td><span class="badge-category">Áo khoác & Blazer</span></td>
                        <td><strong class="text-dark">1.850.000 ₫ – 2.100.000 ₫</strong></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="variant-chip">4 SKU</span>
                                <span class="text-muted small">Tồn: <strong class="text-dark">68</strong></span>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle status-badge">Đang bán</span>
                        </td>
                        <td class="text-end">
                            <a href="/Admin/Products/Edit/1" class="btn btn-outline-dark btn-sm px-2 py-1 me-1" title="Chỉnh sửa sản phẩm [A03]">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <button type="button" class="btn btn-outline-dark btn-sm px-2 py-1 me-1" onclick="viewVariants(1, 'Áo Tweed Thu Đông Cổ Điển', 'AT-TWEED-01', 68, true)" title="Xem biến thể màu/size">
                                <i class="fa-solid fa-boxes-stacked me-1"></i> Biến thể
                            </button>
                            <button type="button" class="btn btn-light btn-sm text-danger border px-2 py-1 toggle-status-btn" onclick="toggleSellStatus('prod-1', 'Áo Tweed Thu Đông', 68, true)" title="Ngừng bán">
                                <i class="fa-solid fa-ban"></i>
                            </button>
                        </td>
