</div>

@section Scripts {
    <script>
        var revChartInstance = null;
        var payChartInstance = null;

        // Dữ liệu đồng bộ Ngày, Tháng, Năm (Hoàn toàn đồng bộ giữa Doanh thu, Cơ cấu thanh toán 2 phương thức CK & COD, và KPI)
        var reportPeriods = {
            'today': {
                subtitle: 'Hôm nay (08/10/2026 theo giờ)',
                syncBadge: 'Hôm nay',
                labels: ['08h', '10h', '12h', '14h', '16h', '18h', '20h'],
                revData: [4.2, 8.5, 6.1, 11.4, 9.3, 14.2, 8.1],
                gross: '62.650.000 ₫',
                ret: '-850.000 ₫',
                net: '61.800.000 ₫',
                inv: '112',
                aov: '551.700 ₫',
                // Cơ cấu thanh toán: 2 phương thức CK & COD
                payCK_pct: 70,
                payCOD_pct: 30,
                payCK_val: '43.260.000 ₫',
                payCOD_val: '18.540.000 ₫'
            },
            '7days': {
                subtitle: '7 ngày qua (T2 - CN)',
                syncBadge: '7 ngày qua',
                labels: ['T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'CN'],
                revData: [14.2, 16.8, 15.4, 19.2, 22.5, 28.1, 12.2],
                gross: '132.400.000 ₫',
                ret: '-3.950.000 ₫',
                net: '128.450.000 ₫',
                inv: '342',
                aov: '375.500 ₫',
                // Cơ cấu thanh toán: 2 phương thức CK & COD
                payCK_pct: 65,
                payCOD_pct: 35,
                payCK_val: '83.500.000 ₫',
                payCOD_val: '44.950.000 ₫'
            },
            'month': {
                subtitle: 'Tháng này (Tháng 10/2026 theo tuần)',
                syncBadge: 'Tháng 10/2026',
                labels: ['Tuần 1', 'Tuần 2', 'Tuần 3', 'Tuần 4'],
                revData: [112, 138, 125, 145],
                gross: '535.800.000 ₫',
                ret: '-15.800.000 ₫',
                net: '520.000.000 ₫',
                inv: '1.410',
                aov: '368.800 ₫',
                // Cơ cấu thanh toán: 2 phương thức CK & COD
                payCK_pct: 62,
                payCOD_pct: 38,
                payCK_val: '322.400.000 ₫',
                payCOD_val: '197.600.000 ₫'
            },
            'year': {
                subtitle: 'Năm nay (Năm 2026 theo quý Q1 - Q4)',
                syncBadge: 'Năm 2026',
                labels: ['Q1', 'Q2', 'Q3', 'Q4'],
                revData: [1450, 1820, 1690, 2100],
                gross: '7.280.000.000 ₫',
                ret: '-220.000.000 ₫',
                net: '7.060.000.000 ₫',
                inv: '19.240',
                aov: '366.900 ₫',
                // Cơ cấu thanh toán: 2 phương thức CK & COD
                payCK_pct: 60,
                payCOD_pct: 40,
                payCK_val: '4.236.000.000 ₫',
                payCOD_val: '2.824.000.000 ₫'
            }
        };

        var currentPeriodKey = '7days';

        document.addEventListener('DOMContentLoaded', function() {
            initReportCharts();
        });

        // 1. Chuyển Tab Báo cáo: Bán hàng vs Tồn kho
        function switchReportTab(tab) {
            var salesSec = document.getElementById('salesReportSection');
            var invSec = document.getElementById('inventoryReportSection');
            var salesBtn = document.getElementById('tabSalesBtn');
            var invBtn = document.getElementById('tabInventoryBtn');

            if (tab === 'sales') {
                salesSec.classList.remove('d-none');
                invSec.classList.add('d-none');
                salesBtn.classList.add('active');
                invBtn.classList.remove('active');
            } else {
                salesSec.classList.add('d-none');
                invSec.classList.remove('d-none');
                salesBtn.classList.remove('active');
                invBtn.classList.add('active');
            }
        }

        // 2. Khởi tạo Biểu đồ Doanh thu & Cơ cấu thanh toán (CK vs COD)
        function initReportCharts() {
            var ctxRev = document.getElementById('revenueTrendChart');
            var initial = reportPeriods[currentPeriodKey];

            if (ctxRev) {
                revChartInstance = new Chart(ctxRev, {
                    type: 'line',
                    data: {
                        labels: initial.labels,
                        datasets: [{
                            label: 'Doanh thu thuần (Triệu ₫)',
                            data: initial.revData,
                            borderColor: '#18181b',
                            backgroundColor: 'rgba(24, 24, 27, 0.04)',
                            tension: 0.3,
                            fill: true,
                            pointBackgroundColor: '#18181b',
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                grid: { color: '#f3f4f6' },
                                ticks: {
                                    callback: function(v) { return v + ' tr'; }
                                }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                });
            }

            // Biểu đồ 2 phương thức: Chuyển khoản (CK) và COD
            var ctxPay = document.getElementById('paymentMethodChart');
            if (ctxPay) {
                payChartInstance = new Chart(ctxPay, {
                    type: 'doughnut',
                    data: {
                        labels: ['Chuyển khoản (CK)', 'COD (Nhận hàng)'],
                        datasets: [{
                            data: [initial.payCK_pct, initial.payCOD_pct],
                            backgroundColor: ['#18181b', '#c5a880'],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { boxWidth: 12, font: { size: 11 } }
                            }
                        }
                    }
                });
            }
        }

        // 3. Đổi thời gian: Đồng bộ cả Doanh thu, Cơ cấu thanh toán CK & COD, và KPI
        function changeReportPeriod(key, btn) {
            document.querySelectorAll('#reportPeriodGroup .period-btn').forEach(function(b) {
                b.classList.remove('active');
            });
            if (btn) btn.classList.add('active');

            currentPeriodKey = key;
            var d = reportPeriods[key];
            if (!d) return;

            // Đồng bộ 5 thẻ KPI
            document.getElementById('kpiGrossSales').innerText = d.gross;
            document.getElementById('kpiReturns').innerText = d.ret;
            document.getElementById('kpiNetRevenue').innerText = d.net;
            document.getElementById('kpiOrderCount').innerText = d.inv;
            document.getElementById('kpiAOV').innerText = d.aov;
            document.getElementById('chartTimeSubtitle').innerText = d.subtitle;
            document.getElementById('paySyncBadge').innerText = d.syncBadge;

            // Đồng bộ Biểu đồ Doanh thu (Đường/Cột)
            if (revChartInstance) {
                revChartInstance.data.labels = d.labels;
                revChartInstance.data.datasets[0].data = d.revData;
                revChartInstance.update();
            }

            // Đồng bộ Biểu đồ Cơ cấu thanh toán (CK vs COD)
            if (payChartInstance) {
                payChartInstance.data.datasets[0].data = [d.payCK_pct, d.payCOD_pct];
                payChartInstance.update();
            }

            // Cập nhật text % và giá trị dưới biểu đồ thanh toán
            document.getElementById('payPercentCK').innerText = d.payCK_pct + '%';
            document.getElementById('payPercentCOD').innerText = d.payCOD_pct + '%';
            document.getElementById('payValueCK').innerText = d.payCK_val;
            document.getElementById('payValueCOD').innerText = d.payCOD_val;
        }

        // 4. Lọc bảng tìm kiếm SKU / Tên SP
        function filterReportTable() {
            var kw = document.getElementById('reportSearchInput').value.toLowerCase().trim();
            var salesRows = document.querySelectorAll('#salesTableBody tr');
            var invRows = document.querySelectorAll('#inventoryTableBody tr');

            [salesRows, invRows].forEach(function(rows) {
                rows.forEach(function(row) {
                    var name = (row.getAttribute('data-name') || '').toLowerCase();
                    var sku = (row.getAttribute('data-sku') || '').toLowerCase();
                    if (kw === '' || name.includes(kw) || sku.includes(kw)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        }

        function resetReportFilter() {
            document.getElementById('reportSearchInput').value = '';
            var btn7Days = document.querySelector('#reportPeriodGroup .period-btn:nth-child(2)');
            changeReportPeriod('7days', btn7Days);
            filterReportTable();
        }

        // 5. Mở modal chi tiết sản phẩm
        function showProductSalesDetail(name, sku, sold, ret, net) {
            document.getElementById('mProdName').innerText = name;
            document.getElementById('mProdSKU').innerText = sku;
            document.getElementById('mProdSold').innerText = sold + ' sản phẩm';
            document.getElementById('mProdReturned').innerText = ret + ' sản phẩm';
            document.getElementById('mProdNet').innerText = net;

            new bootstrap.Modal(document.getElementById('salesDetailModal')).show();
        }

        function exportReportExcel() {
            alert('Đang trích xuất dữ liệu Báo cáo bán hàng & Xuất nhập tồn kho cho Cửa hàng Light Life theo mốc "' + reportPeriods[currentPeriodKey].syncBadge + '" ra file Excel (.xlsx)...');
        }
    </script>
}

