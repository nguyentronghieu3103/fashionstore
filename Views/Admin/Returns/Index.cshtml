        var currentItem = null;

        // Mở Modal Xem & Duyệt
        function openDetail(code) {
            currentItem = itemsData[code];
            if (!currentItem) return;

            document.getElementById('mReqCode').innerText = currentItem.code;
            document.getElementById('mReqType').innerText = currentItem.typeName;
            document.getElementById('mInvoiceCode').innerText = currentItem.invoiceCode;
            document.getElementById('mCustomer').innerText = currentItem.customer;
            document.getElementById('mCreator').innerText = currentItem.creator;
            document.getElementById('mDaysValid').innerText = currentItem.daysValid;
            document.getElementById('mReason').innerText = '"' + currentItem.reason + '"';

            // Trạng thái badge
            renderModalStatusBadge(currentItem.status);

            // Bằng chứng ảnh
            var imgContainer = document.getElementById('mEvidenceImgs');
            imgContainer.innerHTML = '';
            currentItem.images.forEach(function(imgSrc) {
                var img = document.createElement('img');
                img.src = imgSrc;
                img.className = 'evidence-thumb';
                img.onclick = function() {
                    document.getElementById('imgBig').src = imgSrc;
                    new bootstrap.Modal(document.getElementById('imgModal')).show();
                };
                imgContainer.appendChild(img);
            });

            // Danh sách sản phẩm trả & đổi
            var tbody = document.getElementById('mProductTable');
            tbody.innerHTML = '';
            currentItem.products.forEach(function(p) {
                var isRet = p.type === 'return';
                var tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><span class="badge ${isRet ? 'bg-danger-subtle text-danger' : 'bg-primary-subtle text-primary'}">${isRet ? 'Trả lại' : 'Đổi mới'}</span></td>
                    <td><strong>${p.name}</strong> <span class="text-muted small">(${p.spec})</span></td>
                    <td class="text-center">${p.qty}</td>
                    <td class="text-end fw-bold ${isRet ? 'text-danger' : 'text-primary'}">${p.actualPrice}</td>
                `;
                tbody.appendChild(tr);
            });

            // Số tiền hoàn / thanh toán
            document.getElementById('mRefundVal').innerText = currentItem.refundVal;
            document.getElementById('mExchangeVal').innerText = currentItem.exchangeVal;
            document.getElementById('mFinalAmount').innerText = currentItem.finalAmount;
            if (currentItem.isCustomerRefund) {
                document.getElementById('mBalanceLabel').innerText = 'SỐ TIỀN CẦN HOÀN LẠI CHO KHÁCH:';
                document.getElementById('mFinalAmount').className = 'h5 fw-bold text-danger mb-0 font-monospace';
            } else {
                document.getElementById('mBalanceLabel').innerText = 'SỐ TIỀN CẦN THU THÊM TỪ KHÁCH:';
                document.getElementById('mFinalAmount').className = 'h5 fw-bold text-success mb-0 font-monospace';
            }
            document.getElementById('mRefundMethod').innerText = currentItem.refundMethod;

            // Công việc chi tiết & Quyết định
            document.getElementById('mDecisionNote').value = currentItem.decisionNote || '';
            updateWorkView();

            new bootstrap.Modal(document.getElementById('detailModal')).show();
        }

        function renderModalStatusBadge(st) {
            var b = document.getElementById('mStatusBadge');
            if (st === 'pending') {
                b.className = 'approval-badge-pending';
                b.innerHTML = '<i class="fa-solid fa-clock me-1"></i>Chờ duyệt';
            } else if (st === 'processing') {
                b.className = 'approval-badge-approved';
                b.innerHTML = '<i class="fa-solid fa-arrows-rotate me-1"></i>Đang xử lý';
            } else if (st === 'completed') {
                b.className = 'approval-badge-success';
                b.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>Đã hoàn tất';
            } else if (st === 'rejected') {
                b.className = 'approval-badge-rejected';
                b.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i>Từ chối';
            } else if (st === 'supplement') {
                b.className = 'approval-badge-warning';
                b.innerHTML = '<i class="fa-solid fa-circle-question me-1"></i>Yêu cầu bổ sung';
            }
        }

        function updateWorkView() {
            var gBadge = document.getElementById('mGoodsStatus');
            var gNotice = document.getElementById('mGoodsDoneNotice');
            var gBtn = document.getElementById('mBtnGoods');
            if (currentItem.goodsReceived) {
                gBadge.className = 'badge bg-success-subtle text-success';
                gBadge.innerHTML = '<i class="fa-solid fa-check me-1"></i>Đã nhận kho';
                gNotice.classList.remove('d-none');
                gBtn.disabled = true;
            } else {
                gBadge.className = 'badge bg-secondary-subtle text-secondary';
                gBadge.innerText = 'Chưa nhận';
                gNotice.classList.add('d-none');
                gBtn.disabled = (currentItem.status === 'pending' || currentItem.status === 'rejected');
            }

            var mBadge = document.getElementById('mMoneyStatus');
            var mDone = document.getElementById('mMoneyDoneNotice');
            var mErr = document.getElementById('mMoneyErrNotice');
            var mBtn = document.getElementById('mBtnMoney');

            if (currentItem.moneyError) {
                mBadge.className = 'badge bg-danger-subtle text-danger';
                mBadge.innerHTML = '<i class="fa-solid fa-circle-exclamation me-1"></i>Lỗi STK';
                mErr.classList.remove('d-none');
                mDone.classList.add('d-none');
            } else if (currentItem.moneyDone) {
                mBadge.className = 'badge bg-success-subtle text-success';
                mBadge.innerHTML = '<i class="fa-solid fa-check me-1"></i>Đã xong tiền';
                mDone.classList.remove('d-none');
                mErr.classList.add('d-none');
            } else {
                mBadge.className = 'badge bg-secondary-subtle text-secondary';
                mBadge.innerText = 'Chưa hoàn';
                mDone.classList.add('d-none');
                mErr.classList.add('d-none');
            }

            var btnComplete = document.getElementById('mBtnComplete');
            if (currentItem.status === 'completed') {
                btnComplete.disabled = true;
                btnComplete.innerHTML = '<i class="fa-solid fa-check-double me-1"></i> Đã hoàn tất yêu cầu';
            } else {
                btnComplete.disabled = false;
                btnComplete.innerHTML = '<i class="fa-solid fa-flag-checkered me-1"></i> Đóng & Hoàn tất yêu cầu';
            }
        }

        // Quyết định của Admin
        function makeDecision(decision) {
            var note = document.getElementById('mDecisionNote').value.trim();

            if (decision === 'approve') {
                if (!confirm('Xác nhận DUYỆT yêu cầu đổi trả ' + currentItem.code + '?')) return;
                currentItem.status = 'processing';
                currentItem.decisionNote = note || 'Admin đã duyệt yêu cầu.';
                alert('Đã duyệt yêu cầu!');
            } else if (decision === 'reject') {
                if (!note) {
                    alert('Vui lòng nhập lý do từ chối!');
                    return;
                }
                if (!confirm('Xác nhận TỪ CHỐI yêu cầu ' + currentItem.code + '?')) return;
                currentItem.status = 'rejected';
                currentItem.decisionNote = note;
                alert('Đã từ chối yêu cầu.');
            } else if (decision === 'supplement') {
                if (!note) {
                    alert('Vui lòng nhập thông tin cần bổ sung!');
                    return;
                }
                currentItem.status = 'supplement';
                currentItem.decisionNote = note;
                alert('Đã gửi yêu cầu bổ sung thông tin.');
            }

            syncRow(currentItem);
            renderModalStatusBadge(currentItem.status);
            updateWorkView();
        }

        // Thực hiện nhận hàng
        function execGoodsReceive() {
            var wh = document.getElementById('mWarehouseSelect').value;
            if (confirm('Xác nhận ĐÃ NHẬN HÀNG THỰC TẾ vào ' + wh + '?')) {
                currentItem.goodsReceived = true;
                alert('Đã ghi nhận nhận hàng vào ' + wh + '!');
                updateWorkView();
            }
        }

        // Thực hiện hoàn tiền
        function execMoneyRefund(success) {
            if (success) {
                if (confirm('Xác nhận ĐÃ HOÀN TẤT TIỀN ' + currentItem.finalAmount + '?')) {
                    currentItem.moneyDone = true;
                    currentItem.moneyError = false;
                    alert('Đã ghi nhận hoàn tất tiền thành công!');
                    updateWorkView();
                }
            } else {
                alert('Đã ghi nhận lỗi chuyển khoản. Trạng thái giữ "Chờ hoàn" để kiểm tra lại STK.');
                currentItem.moneyError = true;
                currentItem.moneyDone = false;
                updateWorkView();
            }
        }

        // Hoàn tất yêu cầu
        function completeAll() {
            if (!confirm('Xác nhận HOÀN TẤT TOÀN BỘ yêu cầu ' + currentItem.code + '?')) return;
            currentItem.status = 'completed';
            alert('Yêu cầu đổi trả ' + currentItem.code + ' đã được hoàn tất thành công!');
            syncRow(currentItem);
            bootstrap.Modal.getInstance(document.getElementById('detailModal')).hide();
        }

        function syncRow(item) {
            var row = document.getElementById('row-' + item.code);
            if (!row) return;

            row.setAttribute('data-status', item.status);
            var statusTd = row.children[3];

            if (item.status === 'pending') {
                statusTd.innerHTML = '<span class="approval-badge-pending status-badge"><i class="fa-solid fa-clock me-1"></i>Chờ duyệt</span>';
            } else if (item.status === 'processing') {
                statusTd.innerHTML = '<span class="approval-badge-approved status-badge"><i class="fa-solid fa-arrows-rotate me-1"></i>Đang xử lý</span>';
            } else if (item.status === 'completed') {
                statusTd.innerHTML = '<span class="approval-badge-success status-badge"><i class="fa-solid fa-circle-check me-1"></i>Đã hoàn tất</span>';
            } else if (item.status === 'rejected') {
                statusTd.innerHTML = '<span class="approval-badge-rejected status-badge"><i class="fa-solid fa-circle-xmark me-1"></i>Từ chối</span>';
            } else if (item.status === 'supplement') {
                statusTd.innerHTML = '<span class="approval-badge-warning status-badge"><i class="fa-solid fa-circle-question me-1"></i>Yêu cầu bổ sung</span>';
            }
        }

        // Lọc bảng
        function filterReturns() {
            var kw = document.getElementById('returnSearchInput').value.toLowerCase().trim();
            var tp = document.getElementById('returnTypeFilter').value;
            var st = document.getElementById('returnStatusFilter').value;

            var rows = document.querySelectorAll('#returnTableBody tr');
            var visible = 0;

            rows.forEach(function(row) {
                var rowSt = row.getAttribute('data-status') || '';
                var rowTp = row.getAttribute('data-type') || '';
                var text = row.innerText.toLowerCase();

                var matchKw = (kw === '' || text.includes(kw));
                var matchTp = (tp === '' || rowTp === tp);
                var matchSt = (st === '' || rowSt === st);

                if (matchKw && matchTp && matchSt) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('visibleCount').innerText = visible;
        }

        function resetFilter() {
            document.getElementById('returnSearchInput').value = '';
            document.getElementById('returnTypeFilter').value = '';
            document.getElementById('returnStatusFilter').value = '';
            filterReturns();
        }
    </script>
}

