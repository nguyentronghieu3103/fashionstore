                initial: "1.000.000 ₫",
                sales: "0 ₫",
                refund: "0 ₫",
                expense: "0 ₫",
                expected: "1.000.000 ₫",
                expectedRaw: 1000000,
                actual: "--",
                actualRaw: 0,
                diffText: "--",
                diffType: "none",
                explain: "",
                adminNote: ""
            },
            {
                code: "CA-1007-01",
                name: "Ca Sáng",
                timeRange: "08:00 - 15:30",
                date: "2026-10-07",
                dateType: "yesterday",
                counter: "Quầy chính",
                staffId: "NV01",
                staffName: "Lê Hoàng Lan",
                status: "closed", // Đã duyệt chốt ca
                initial: "2.000.000 ₫",
                sales: "+12.200.000 ₫",
                refund: "0 ₫",
                expense: "0 ₫",
                expected: "14.200.000 ₫",
                expectedRaw: 14200000,
                actual: "14.200.000 ₫",
                actualRaw: 14200000,
                diffText: "Khớp tiền (0 ₫)",
                diffType: "match",
                explain: "Số tiền thực đếm khớp hoàn toàn 100% với hệ thống.",
                adminNote: "Admin đã kiểm tra và duyệt chốt ca thành công."
            },
            {
                code: "CA-1007-02",
                name: "Ca Chiều",
                timeRange: "15:30 - 22:00",
                date: "2026-10-07",
                dateType: "yesterday",
                counter: "Quầy chính",
                staffId: "NV03",
                staffName: "Đỗ Thị Yến",
                status: "closed",
                initial: "2.000.000 ₫",
                sales: "+16.620.000 ₫",
                refund: "-200.000 ₫",
                expense: "0 ₫",
                expected: "18.420.000 ₫",
                expectedRaw: 18420000,
                actual: "18.370.000 ₫",
                actualRaw: 18370000,
                diffText: "-50.000 ₫ (Thiếu)",
                diffType: "under",
                explain: "Thu ngân nghi ngờ trả nhầm tiền thối cho khách lúc cao điểm 19:30.",
                adminNote: "Đã kiểm tra đối chiếu và duyệt chốt ca."
            }
        ];

        var selectedAssignDate = "today";
        var currentAssignTargetCode = null;
        var currentAuditShift = null;

        document.addEventListener('DOMContentLoaded', function () {
            renderAssignCards();
            renderAuditTable();
            updateTopBadges();
        });

        function updateTopBadges() {
            var todayShifts = shiftPlans.filter(function (s) { return s.dateType === 'today'; });
            document.getElementById('badgeAssignCount').innerText = todayShifts.length + ' ca hôm nay';

            var pendingShifts = shiftPlans.filter(function (s) { return s.status === 'pending'; });
            document.getElementById('badgePendingCount').innerText = pendingShifts.length + ' chờ duyệt';
            document.getElementById('statPendingCount').innerText = pendingShifts.length + ' ca';

            var openShifts = shiftPlans.filter(function (s) { return s.status === 'open'; });
            document.getElementById('statOpenCount').innerText = openShifts.length + ' ca';

            var closedShifts = shiftPlans.filter(function (s) { return s.status === 'closed'; });
            document.getElementById('statClosedCount').innerText = closedShifts.length + ' ca';
        }

        /* ==========================================================================
           PHẦN 1: PHÂN CÔNG CA LÀM VIỆC (Gán ca, Đổi người, Hủy ca)
           ========================================================================== */
        function selectAssignDate(type) {
            selectedAssignDate = type;
            document.getElementById('btnDateToday').className = type === 'today' ? 'btn btn-dark' : 'btn btn-outline-secondary';
            document.getElementById('btnDateTomorrow').className = type === 'tomorrow' ? 'btn btn-dark' : 'btn btn-outline-secondary';
            if (type === 'today') {
                document.getElementById('assignDatePicker').value = '2026-10-08';
            } else {
                document.getElementById('assignDatePicker').value = '2026-10-09';
            }
            renderAssignCards();
        }

        function onCustomDateChange(val) {
            if (val === '2026-10-08') {
                selectAssignDate('today');
            } else if (val === '2026-10-09') {
                selectAssignDate('tomorrow');
            } else {
                document.getElementById('btnDateToday').className = 'btn btn-outline-secondary';
                document.getElementById('btnDateTomorrow').className = 'btn btn-outline-secondary';
                selectedAssignDate = val;
                renderAssignCards();
            }
        }

        function renderAssignCards() {
            var container = document.getElementById('assignShiftCardsContainer');
            var list = shiftPlans.filter(function (s) {
                if (selectedAssignDate === 'today') return s.dateType === 'today';
                if (selectedAssignDate === 'tomorrow') return s.date === '2026-10-09';
                return s.date === selectedAssignDate;
            });

            if (list.length === 0) {
                container.innerHTML = `
                    <div class="col-12 text-center py-5 bg-white rounded-3 border">
                        <i class="fa-solid fa-calendar-xmark text-muted fs-2 mb-2"></i>
                        <p class="text-muted mb-0">Chưa có ca làm việc nào được tạo cho ngày này.</p>
                    </div>
                `;
                return;
            }

            var html = '';
            list.forEach(function (shift) {
                var isAssigned = !!shift.staffName;
                var staffInfo = staffList.find(function (st) { return st.id === shift.staffId; });
                var avatarColor = staffInfo ? staffInfo.color : '#6b7280';
                var initials = shift.staffName ? shift.staffName.split(' ').slice(-1)[0][0] : '?';

                html += `
                    <div class="col-md-6 col-lg-4">
                        <div class="card-plan p-3 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="font-monospace fw-bold text-dark">${shift.code}</div>
                                        <h6 class="fw-bold text-dark mb-0">${shift.name} (${shift.timeRange})</h6>
                                        <small class="text-muted"><i class="fa-solid fa-store me-1"></i>${shift.counter}</small>
                                    </div>
                                    ${isAssigned ? 
                                        `<span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Đã phân công</span>` :
                                        `<span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">Còn trống</span>`
                                    }
                                </div>

                                <div class="p-3 rounded-3 border bg-light my-3">
                                    ${isAssigned ? `
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="staff-avatar-circle text-white" style="background-color: ${avatarColor};">
                                                ${initials}
                                            </div>
                                            <div class="overflow-hidden">
                                                <div class="fw-bold text-dark text-truncate">${shift.staffName}</div>
                                                <div class="small text-muted">${staffInfo ? staffInfo.role : 'Thu ngân'}</div>
                                                <small class="text-muted font-monospace"><i class="fa-solid fa-phone me-1"></i>${staffInfo ? staffInfo.phone : 'N/A'}</small>
                                            </div>
                                        </div>
                                    ` : `
                                        <div class="text-center py-2 text-muted">
                                            <i class="fa-solid fa-user-slash fs-4 d-block mb-1 text-secondary opacity-50"></i>
                                            <span class="small">Chưa có nhân viên phụ trách ca này</span>
                                        </div>
                                    `}
                                </div>
                            </div>

                            <!-- Thao tác phân ca / đổi người / hủy ca -->
                            <div class="pt-2 border-top d-flex gap-2 justify-content-end">
                                ${isAssigned ? `
                                    <button class="btn btn-outline-danger btn-sm px-2" title="Hủy phân công ca này" onclick="cancelShiftAssignment('${shift.code}')">
                                        <i class="fa-solid fa-user-xmark me-1"></i> Hủy ca
                                    </button>
                                    <button class="btn btn-outline-dark btn-sm px-3" title="Đổi sang nhân viên khác" onclick="openAssignModal('${shift.code}', true)">
                                        <i class="fa-solid fa-rotate me-1 text-primary"></i> Đổi người
                                    </button>
                                ` : `
                                    <button class="btn btn-dark btn-sm px-3 w-100" onclick="openAssignModal('${shift.code}', false)">
                                        <i class="fa-solid fa-user-plus me-1 text-warning"></i> Chọn nhân viên phân ca
                                    </button>
                                `}
                            </div>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function openAssignModal(shiftCode, isChange) {
            currentAssignTargetCode = shiftCode;
            var shift = shiftPlans.find(function (s) { return s.code === shiftCode; });
            if (!shift) return;

            document.getElementById('assignModalTitle').innerText = isChange ? 'Đổi nhân viên ca ' + shift.code : 'Phân công ca ' + shift.code;
            document.getElementById('assignModalSubtitle').innerText = shift.name + ' (' + shift.timeRange + ') · ' + shift.counter;
            document.getElementById('staffSearchInput').value = '';

            renderStaffPickerList('');
            new bootstrap.Modal(document.getElementById('assignModal')).show();
        }

        function renderStaffPickerList(keyword) {
            var container = document.getElementById('staffPickerList');
            var kw = (keyword || '').toLowerCase().trim();
            var shift = shiftPlans.find(function (s) { return s.code === currentAssignTargetCode; });

            var filtered = staffList.filter(function (st) {
                return st.name.toLowerCase().includes(kw) || st.id.toLowerCase().includes(kw) || st.role.toLowerCase().includes(kw);
            });

            if (filtered.length === 0) {
                container.innerHTML = '<div class="text-center text-muted py-3 small">Không tìm thấy nhân viên phù hợp.</div>';
                return;
            }

            var html = '';
            filtered.forEach(function (st) {
                var isCurrent = shift && shift.staffId === st.id;
                var initials = st.name.split(' ').slice(-1)[0][0];

                html += `
                    <div class="staff-picker-item d-flex align-items-center justify-content-between ${isCurrent ? 'bg-light border-dark' : ''}" onclick="selectStaffForShift('${st.id}')">
                        <div class="d-flex align-items-center gap-2">
                            <div class="staff-avatar-circle text-white" style="width: 32px; height: 32px; font-size: 0.8rem; background-color: ${st.color};">
                                ${initials}
                            </div>
                            <div>
                                <div class="fw-semibold text-dark small">${st.name} <span class="text-muted font-monospace">(${st.id})</span></div>
                                <div class="text-muted" style="font-size: 0.75rem;">${st.role} · ${st.phone}</div>
                            </div>
                        </div>
                        <div>
                            ${isCurrent ? 
                                `<span class="badge bg-dark text-white font-monospace" style="font-size: 0.7rem;">Đang trong ca</span>` :
                                `<button type="button" class="btn btn-outline-dark btn-sm py-0 px-2" style="font-size: 0.75rem;">Chọn</button>`
                            }
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function filterStaffList() {
            var kw = document.getElementById('staffSearchInput').value;
            renderStaffPickerList(kw);
        }

        function selectStaffForShift(staffId) {
            var shift = shiftPlans.find(function (s) { return s.code === currentAssignTargetCode; });
            var staff = staffList.find(function (st) { return st.id === staffId; });
            if (!shift || !staff) return;

            var oldStaff = shift.staffName;
            shift.staffId = staff.id;
            shift.staffName = staff.name;

            if (shift.status === 'unassigned') {
                shift.status = 'open';
            }

            bootstrap.Modal.getInstance(document.getElementById('assignModal')).hide();
            renderAssignCards();
            renderAuditTable();
            updateTopBadges();

            if (oldStaff) {
                alert('Đã đổi người thành công ca ' + shift.code + ':\nTừ: ' + oldStaff + ' ➜ Sang: ' + staff.name);
            } else {
                alert('Đã phân công thành công nhân viên: ' + staff.name + ' vào ' + shift.code);
            }
        }

        function cancelShiftAssignment(shiftCode) {
            var shift = shiftPlans.find(function (s) { return s.code === shiftCode; });
            if (!shift) return;

            if (!confirm('Bạn có chắc chắn muốn HỦY PHÂN CÔNG nhân viên ' + shift.staffName + ' khỏi ca ' + shift.code + '?\nCa này sẽ chuyển về trạng thái TRỐNG để gán người khác.')) return;

            shift.staffId = null;
            shift.staffName = null;
            shift.status = 'unassigned';

            renderAssignCards();
            renderAuditTable();
            updateTopBadges();
            alert('Đã hủy phân công ca ' + shift.code + '. Ca đang trống chờ phân người mới.');
        }

        /* ==========================================================================
           PHẦN 2: SOÁT CA & DUYỆT OUT CA (ADMIN)
           ========================================================================== */
        function renderAuditTable() {
            var tbody = document.getElementById('auditTableBody');
            var kw = (document.getElementById('auditSearchInput') ? document.getElementById('auditSearchInput').value : '').toLowerCase().trim();
            var stFilter = document.getElementById('auditStatusFilter') ? document.getElementById('auditStatusFilter').value : '';

            var visibleCount = 0;
            var html = '';

            // Ưu tiên pending (Chờ duyệt out ca) lên đầu
            var sortedList = shiftPlans.slice().sort(function(a, b) {
                var order = { "pending": 1, "open": 2, "closed": 3, "unassigned": 4 };
                return (order[a.status] || 99) - (order[b.status] || 99);
            });

            sortedList.forEach(function (shift) {
                if (shift.status === 'unassigned') return;

                var matchKw = (kw === '' || shift.code.toLowerCase().includes(kw) || (shift.staffName && shift.staffName.toLowerCase().includes(kw)));
                var matchSt = (stFilter === '' || shift.status === stFilter);

                if (!matchKw || !matchSt) return;

                visibleCount++;

                var statusBadge = '';
                var actionBtn = '';

                if (shift.status === 'pending') {
                    statusBadge = '<span class="shift-badge-pending"><i class="fa-solid fa-clock me-1"></i>Chờ duyệt out ca</span>';
                    actionBtn = `
                        <button type="button" class="btn btn-dark btn-sm px-3 fw-bold" onclick="openShiftAuditModal('${shift.code}')">
                            <i class="fa-solid fa-clipboard-check me-1 text-warning"></i> Kiểm tra & Duyệt
                        </button>
                    `;
                } else if (shift.status === 'open') {
                    statusBadge = '<span class="shift-badge-open"><i class="fa-solid fa-arrows-rotate me-1"></i>Đang làm việc</span>';
                    actionBtn = `
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="openShiftAuditModal('${shift.code}')">
                            <i class="fa-solid fa-eye me-1"></i> Xem thông tin
                        </button>
                    `;
                } else if (shift.status === 'closed') {
                    statusBadge = '<span class="shift-badge-closed"><i class="fa-solid fa-circle-check me-1"></i>Đã chốt ca</span>';
                    actionBtn = `
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="openShiftAuditModal('${shift.code}')">
                            <i class="fa-solid fa-eye me-1"></i> Xem chi tiết
                        </button>
                    `;
                }

                var diffBadge = '<span class="text-muted small">--</span>';
                if (shift.diffType === 'match') diffBadge = `<span class="diff-tag-match">${shift.diffText}</span>`;
                else if (shift.diffType === 'over') diffBadge = `<span class="diff-tag-over">${shift.diffText}</span>`;
                else if (shift.diffType === 'under') diffBadge = `<span class="diff-tag-under">${shift.diffText}</span>`;

                html += `
                    <tr id="row-${shift.code}">
                        <td>
                            <div class="font-monospace fw-bold text-dark">${shift.code}</div>
                            <small class="text-muted">${shift.name} (${shift.timeRange}) · ${shift.date}</small>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">${shift.staffName || 'Chưa phân công'}</div>
                            <small class="text-muted">${shift.counter}</small>
                        </td>
                        <td class="text-end font-monospace">${shift.expected}</td>
                        <td class="text-end fw-bold font-monospace text-dark">${shift.actual}</td>
                        <td class="text-center">${diffBadge}</td>
                        <td>${statusBadge}</td>
                        <td class="text-end">${actionBtn}</td>
                    </tr>
                `;
            });

            tbody.innerHTML = html || '<tr><td colspan="7" class="text-center text-muted py-4">Không tìm thấy ca làm việc nào phù hợp.</td></tr>';
            var countEl = document.getElementById('visibleAuditCount');
            if (countEl) countEl.innerText = visibleCount;
        }

        function filterAuditShifts() {
            renderAuditTable();
        }

        function resetAuditFilter() {
            document.getElementById('auditSearchInput').value = '';
            document.getElementById('auditStatusFilter').value = '';
            renderAuditTable();
        }

        function openShiftAuditModal(code) {
            currentAuditShift = shiftPlans.find(function (s) { return s.code === code; });
            if (!currentAuditShift) return;

            document.getElementById('mShiftCode').innerText = currentAuditShift.code;
            document.getElementById('mCashierName').innerText = currentAuditShift.staffName || 'Chưa có';
            document.getElementById('mShiftTime').innerText = currentAuditShift.timeRange + ' (' + currentAuditShift.date + ')';

            var b = document.getElementById('mShiftStatusBadge');
            if (currentAuditShift.status === 'pending') {
                b.className = 'shift-badge-pending';
                b.innerHTML = '<i class="fa-solid fa-clock me-1"></i>Chờ duyệt out ca';
            } else if (currentAuditShift.status === 'closed') {
                b.className = 'shift-badge-closed';
                b.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>Đã chốt ca';
            } else if (currentAuditShift.status === 'open') {
                b.className = 'shift-badge-open';
                b.innerHTML = '<i class="fa-solid fa-arrows-rotate me-1"></i>Đang làm việc';
            }

            document.getElementById('mInitialCash').innerText = currentAuditShift.initial;
            document.getElementById('mCashSales').innerText = currentAuditShift.sales;
            document.getElementById('mCashRefund').innerText = currentAuditShift.refund;
            document.getElementById('mExpense').innerText = currentAuditShift.expense;
            document.getElementById('mExpectedCash').innerText = currentAuditShift.expected;

            document.getElementById('mActualCashInput').value = currentAuditShift.actual;

            var diffEl = document.getElementById('mDiffDisplay');
            if (currentAuditShift.diffType === 'match') {
                diffEl.innerHTML = '<span class="diff-tag-match">' + currentAuditShift.diffText + '</span>';
            } else if (currentAuditShift.diffType === 'over') {
                diffEl.innerHTML = '<span class="diff-tag-over">' + currentAuditShift.diffText + '</span>';
            } else if (currentAuditShift.diffType === 'under') {
                diffEl.innerHTML = '<span class="diff-tag-under">' + currentAuditShift.diffText + '</span>';
            } else {
                diffEl.innerHTML = '<span class="text-muted small">' + currentAuditShift.diffText + '</span>';
            }

            document.getElementById('mCashierExplain').innerText = currentAuditShift.explain || 'Không có ghi chú.';
            document.getElementById('mAdminNote').value = currentAuditShift.adminNote || '';

            var btnApprove = document.getElementById('mBtnApproveShift');
            if (currentAuditShift.status === 'closed') {
                btnApprove.disabled = true;
                btnApprove.className = 'btn btn-secondary btn-sm px-4';
                btnApprove.innerHTML = '<i class="fa-solid fa-check-double me-1"></i> Ca đã duyệt chốt';
            } else if (currentAuditShift.status === 'open') {
                btnApprove.disabled = true;
                btnApprove.className = 'btn btn-outline-primary btn-sm px-4';
                btnApprove.innerHTML = '<i class="fa-solid fa-clock me-1"></i> Chưa có yêu cầu Out ca';
            } else {
                btnApprove.disabled = false;
                btnApprove.className = 'btn btn-success btn-sm px-4 fw-bold';
                btnApprove.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Duyệt chốt ca';
            }

            new bootstrap.Modal(document.getElementById('shiftAuditModal')).show();
        }

        function confirmApproveShift() {
            if (!currentAuditShift) return;

            var note = document.getElementById('mAdminNote').value.trim() || 'Admin đã kiểm tra tiền mặt và đồng ý duyệt chốt ca.';
            if (!confirm('XÁC NHẬN DUYỆT CHỐT CA ' + currentAuditShift.code + '?\n\n- Thu ngân out ca: ' + currentAuditShift.staffName + '\n- Số tiền nộp: ' + currentAuditShift.actual)) return;

            currentAuditShift.status = 'closed';
            currentAuditShift.adminNote = note;

            bootstrap.Modal.getInstance(document.getElementById('shiftAuditModal')).hide();
            renderAuditTable();
            updateTopBadges();
            alert('🎉 Đã duyệt chốt ca ' + currentAuditShift.code + ' thành công!');
        }

        function exportData() {
            alert('Đang trích xuất dữ liệu phân ca và lịch sử soát ca làm việc ra định dạng Excel...');
        }
    </script>
}

