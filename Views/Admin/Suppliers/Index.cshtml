@{
    ViewData["Title"] = "Nhà cung cấp & Nguồn hàng";
}

@section Styles {
    <style>
        .supplier-avatar {
            width: 42px;
            height: 42px;
            border-radius: 8px;
            background: #18181b;
            color: #c5a880;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.9rem;
            border: 1px solid #c5a880;
        }

        .supplier-table thead th {
            background: #fafafa;
            color: #6b7280;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .supplier-table tbody td {
            padding: 1rem 1.25rem;
            vertical-align: middle;
            font-size: 0.9rem;
            border-bottom: 1px solid #f3f4f6;
        }

        .supplier-table tbody tr:hover {
            background-color: #fafafa;
        }

        .filter-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 1rem 1.25rem;
        }

        .badge-active {
            background: #ecfdf5;
            color: #059669;
            border: 1px solid #a7f3d0;
            font-weight: 600;
            font-size: 0.72rem;
            padding: 3px 8px;
            border-radius: 4px;
        }

        .badge-inactive {
            background: #f3f4f6;
            color: #6b7280;
            border: 1px solid #e5e7eb;
            font-weight: 600;
            font-size: 0.72rem;
            padding: 3px 8px;
            border-radius: 4px;
        }

        .history-table th {
            font-size: 0.75rem;
            font-weight: 600;
            color: #6b7280;
            background: #f9fafb;
            padding: 0.65rem 0.75rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .history-table td {
            padding: 0.65rem 0.75rem;
            font-size: 0.85rem;
            vertical-align: middle;
            border-bottom: 1px solid #f3f4f6;
        }

        .required-star {
            color: #ef4444;
            font-weight: bold;
        }
    </style>
}

<div class="container-fluid p-0">

    <!-- 1. Khung đầu: Tiêu đề, Thống kê đối tác & Thao tác Admin -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h4 class="fw-bold mb-1 text-dark">Nhà cung cấp</h4>
            </div>
            <div class="text-muted small">
                Quản lý nguồn hàng và đối tác cung ứng, liên kết chứng từ phiếu nhập  (Tổng số: <strong class="text-dark" id="totalSupplierCount">5 nhà cung cấp</strong> · 4 đang hợp tác)
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-dark btn-sm px-3 d-inline-flex align-items-center gap-2" onclick="exportSupplierData()">
                <i class="fa-solid fa-file-export"></i>
                <span>Xuất danh sách</span>
            </button>
            <button class="btn btn-dark btn-sm px-3 d-inline-flex align-items-center gap-2" onclick="openCreateSupplierModal()">
                <i class="fa-solid fa-plus"></i>
                <span>Thêm nhà cung cấp</span>
            </button>
        </div>
    </div>

    <!-- 2. Khung tìm: Tên, Mã, SĐT, Trạng thái -->
    <div class="filter-card mb-4">
        <div class="row g-2 align-items-center">
            <!-- Tìm tên sản phẩm, công ty, SĐT -->
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="suppSearchInput" class="form-control border-start-0 ps-1" placeholder="Tìm theo tên sản phẩm, tên công ty, số điện thoại, mã NCC..." onkeyup="filterSuppliers()" />
                </div>
            </div>

            <!-- Phân loại nhóm hàng -->
            <div class="col-md-3">
                <select id="suppGroupFilter" class="form-select form-select-sm" onchange="filterSuppliers()">
                    <option value="">Tất cả nhóm nguồn hàng</option>
                    <option value="Dạ & Tweed">Dạ & Vải Tweed cao cấp</option>
                    <option value="Lụa & Satin">Lụa Satin & Tơ tằm</option>
                    <option value="Linen & Cotton">Vải Linen & Cotton sợi</option>
                    <option value="Phụ liệu">Phụ liệu & Cúc khuy</option>
                </select>
            </div>

            <!-- Trạng thái hợp tác -->
            <div class="col-md-2">
                <select id="suppStatusFilter" class="form-select form-select-sm" onchange="filterSuppliers()">
                    <option value="">Tất cả trạng thái</option>
                    <option value="active">Đang hợp tác</option>
                    <option value="stopped">Ngừng hợp tác</option>
                </select>
            </div>

            <!-- Đặt lại -->
            <div class="col-md-2 text-md-end">
                <button type="button" class="btn btn-light btn-sm text-secondary w-100" onclick="resetSupplierFilter()">
                    <i class="fa-solid fa-rotate-left me-1"></i> Đặt lại
                </button>
            </div>
        </div>
    </div>

    <!-- 3. Khung bảng: Tên sản phẩm, Tên công ty cung cấp, Số điện thoại, Trạng thái, Thao tác -->
    <div class="card border border-1 rounded-3 overflow-hidden shadow-none mb-4">
        <div class="table-responsive">
            <table class="table supplier-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Tên sản phẩm</th>
                        <th>Tên công ty cung cấp</th>
                        <th>Số điện thoại</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
