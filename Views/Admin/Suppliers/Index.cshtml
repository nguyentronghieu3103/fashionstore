<!-- MODAL: Khung hồ sơ & Lịch sử chứng từ chi tiết [A05 - Profile Drawer] -->
<div class="modal fade" id="supplierProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header border-bottom p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="supplier-avatar" id="modalSuppAvatar">TW</div>
                    <div>
                        <h6 class="modal-title fw-bold text-dark mb-0" id="modalSuppName">Dệt May Vải Tweed Hương Giang</h6>
                        <span class="badge bg-light text-dark border font-monospace" id="modalSuppCode">NCC-001</span>
                        <span class="badge-active ms-1" id="modalSuppStatus">Đang hợp tác</span>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <!-- Chi tiết hồ sơ nhà cung cấp đầy đủ -->
                <div class="row g-3 mb-3 p-3 bg-light rounded border">
                    <!-- Hàng 1: Sản phẩm cung cấp & Nhóm nguồn hàng -->
                    <div class="col-md-8">
                        <small class="text-muted d-block">Tên sản phẩm / Mặt hàng cung ứng chính:</small>
                        <strong class="text-dark" id="modalSuppProducts">Vải Tweed dệt kim sợi nổi, Dạ Tweed kem be dệt thoi</strong>
                    </div>
                    <div class="col-md-4">
