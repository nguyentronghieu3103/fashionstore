<!-- MODAL: Thêm / Sửa nhà cung cấp [A05] -->
<div class="modal fade" id="supplierFormModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header border-bottom p-3">
                <h6 class="modal-title fw-bold text-dark" id="supplierFormModalTitle">Thêm nhà cung cấp mới</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="formSuppId" value="0" />

                <div class="row g-2 mb-3">
                    <div class="col-8">
                        <label class="form-label small fw-semibold text-dark">
                            Tên nhà cung cấp / Xưởng may <span class="required-star">*</span>
                        </label>
                        <input type="text" class="form-control form-control-sm" id="formSuppName" placeholder="Ví dụ: Dệt May Vải Tweed Hương Giang" required />
                        <small class="text-danger d-none" id="errSuppName" style="font-size: 0.72rem;">⚠️ Vui lòng nhập tên nhà cung cấp!</small>
                    </div>
                    <div class="col-4">
                        <label class="form-label small fw-semibold text-dark">
                            Mã NCC <span class="required-star">*</span>
                        </label>
                        <input type="text" class="form-control form-control-sm font-monospace text-uppercase" id="formSuppCode" placeholder="NCC-006" required onblur="checkDuplicateCode(this.value)" />
                        <small class="text-danger d-none" id="errSuppCode" style="font-size: 0.72rem;">⚠️ Mã NCC đã tồn tại!</small>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-7">
                        <label class="form-label small fw-semibold text-dark">
                            Tên sản phẩm / Mặt hàng cung cấp <span class="required-star">*</span>
                        </label>
                        <input type="text" class="form-control form-control-sm" id="formSuppProducts" placeholder="Ví dụ: Vải Tweed dệt kim sợi nổi..." required />
                        <small class="text-danger d-none" id="errSuppProducts" style="font-size: 0.72rem;">⚠️ Vui lòng nhập tên sản phẩm cung cấp!</small>
                    </div>
                    <div class="col-5">
                        <label class="form-label small fw-semibold text-dark">Nhóm nguồn hàng</label>
                        <select class="form-select form-select-sm" id="formSuppGroup">
                            <option value="Dạ & Tweed">Dạ & Vải Tweed</option>
                            <option value="Lụa & Satin">Lụa Satin & Tơ tằm</option>
                            <option value="Linen & Cotton">Vải Linen & Cotton</option>
                            <option value="Phụ liệu">Phụ liệu may mặc</option>
                        </select>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-dark">
                            Người đại diện liên hệ <span class="required-star">*</span>
                        </label>
                        <input type="text" class="form-control form-control-sm" id="formSuppContact" placeholder="Ví dụ: Vũ Hoàng Long" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-dark">
                            Số điện thoại <span class="required-star">*</span>
                        </label>
                        <input type="text" class="form-control form-control-sm font-monospace" id="formSuppPhone" placeholder="09xxxxxxxx" required onblur="checkDuplicatePhone(this.value)" />
                        <small class="text-danger d-none" id="errSuppPhone" style="font-size: 0.72rem;">⚠️ Số điện thoại đã tồn tại!</small>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-dark">Email liên hệ</label>
                        <input type="email" class="form-control form-control-sm" id="formSuppEmail" placeholder="supplier@@example.com" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark">Địa chỉ nhà xưởng / Kho xuất hàng</label>
                    <input type="text" class="form-control form-control-sm" id="formSuppAddress" placeholder="Số nhà, tên đường, KCN, quận/huyện, tỉnh/thành..." />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-dark">Mã số thuế</label>
                        <input type="text" class="form-control form-control-sm font-monospace" id="formSuppTax" placeholder="MST doanh nghiệp..." />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold text-dark">Tài khoản ngân hàng</label>
                        <input type="text" class="form-control form-control-sm" id="formSuppBank" placeholder="Ngân hàng - Số TK (Chủ TK)..." />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-semibold text-dark">Ghi chú & chính sách hợp tác</label>
                    <textarea class="form-control form-control-sm" id="formSuppNotes" rows="2" placeholder="Chính sách chiết khấu, thời gian giao hàng, cam kết chất lượng..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-top p-3">
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-dark btn-sm px-3" onclick="saveSupplier()">Lưu thông tin</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var existingCodes = ['NCC-001', 'NCC-002', 'NCC-003', 'NCC-004', 'NCC-005'];
        var existingPhones = ['0903881334', '0912345678', '0988776655', '0933221100', '0908112233'];
        var currentSelectedSuppId = 1;

        // 1. Kiểm tra trùng lặp
        function checkDuplicateCode(code) {
            var clean = code.trim().toUpperCase();
            var editingId = parseInt(document.getElementById('formSuppId').value) || 0;
            var errEl = document.getElementById('errSuppCode');
            if (clean && editingId === 0 && existingCodes.includes(clean)) {
                errEl.classList.remove('d-none');
            } else {
                errEl.classList.add('d-none');
            }
        }

        function checkDuplicatePhone(phone) {
            var clean = phone.replace(/\s+/g, '');
            var editingId = parseInt(document.getElementById('formSuppId').value) || 0;
            var errEl = document.getElementById('errSuppPhone');
            if (clean && editingId === 0 && existingPhones.includes(clean)) {
                errEl.classList.remove('d-none');
            } else {
                errEl.classList.add('d-none');
            }
        }

        // 2. Mở Modal Hồ sơ chi tiết
        function viewSupplierProfile(id, code, name, contact, phone, email, address, tax, bank, status, notes, totalReceipts, totalSpent, hasDraft, products, group) {
            currentSelectedSuppId = id;
            document.getElementById('modalSuppName').innerText = name;
            document.getElementById('modalSuppCode').innerText = code;
            document.getElementById('modalSuppContact').innerText = contact;
            document.getElementById('modalSuppPhone').innerText = phone;
            document.getElementById('modalSuppEmail').innerText = email;
            document.getElementById('modalSuppAddress').innerText = address;
            document.getElementById('modalSuppTax').innerText = tax || 'Chưa cập nhật';
            document.getElementById('modalSuppBank').innerText = bank || 'Chưa cập nhật';
            document.getElementById('modalSuppNotes').innerText = notes;
            document.getElementById('modalSuppTotalSpent').innerText = totalSpent;
            document.getElementById('modalSuppReceiptsCount').innerText = totalReceipts + ' phiếu';
            document.getElementById('modalSuppProducts').innerText = products || 'Chưa cập nhật';
            document.getElementById('modalSuppGroup').innerText = group || 'Nguồn hàng tiêu chuẩn';

            var avatarInitials = name.split(' ').map(function(w) { return w[0]; }).join('').toUpperCase();
            if (avatarInitials.length > 2) avatarInitials = avatarInitials.substring(0, 2);
            document.getElementById('modalSuppAvatar').innerText = avatarInitials;

            var statusEl = document.getElementById('modalSuppStatus');
            if (status === 'Đang hợp tác') {
                statusEl.className = 'badge-active ms-1';
                statusEl.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>Đang hợp tác';
            } else {
                statusEl.className = 'badge-inactive ms-1';
                statusEl.innerHTML = '<i class="fa-solid fa-ban me-1"></i>Ngừng hợp tác';
            }

            var modal = new bootstrap.Modal(document.getElementById('supplierProfileModal'));
            modal.show();
        }

        // Chuyển sang lập phiếu nhập N10
        function createGoodsReceiptForSupplier() {
            var code = document.getElementById('modalSuppCode').innerText;
            var name = document.getElementById('modalSuppName').innerText;
            alert('Chuyển sang luồng [N10] Lập phiếu nhập kho cho nhà cung cấp: ' + name + ' (' + code + ').');
        }

        function editCurrentSupplierFromModal() {
            bootstrap.Modal.getInstance(document.getElementById('supplierProfileModal')).hide();
            // Lấy dòng tương ứng để sửa
            var row = document.getElementById('supp-row-' + currentSelectedSuppId);
            if (row) {
                var editBtn = row.querySelector('button[title="Sửa thông tin"]');
                if (editBtn) editBtn.click();
            }
        }

        // 3. Mở Modal Thêm mới
        function openCreateSupplierModal() {
            document.getElementById('supplierFormModalTitle').innerText = 'Thêm nhà cung cấp mới [A05]';
            document.getElementById('formSuppId').value = '0';
            document.getElementById('formSuppName').value = '';
            document.getElementById('formSuppCode').value = 'NCC-00' + (existingCodes.length + 1);
            document.getElementById('formSuppProducts').value = '';
            document.getElementById('formSuppContact').value = '';
            document.getElementById('formSuppPhone').value = '';
            document.getElementById('formSuppEmail').value = '';
            document.getElementById('formSuppAddress').value = '';
            document.getElementById('formSuppTax').value = '';
            document.getElementById('formSuppBank').value = '';
            document.getElementById('formSuppNotes').value = '';

            document.getElementById('errSuppName').classList.add('d-none');
            document.getElementById('errSuppCode').classList.add('d-none');
            document.getElementById('errSuppProducts').classList.add('d-none');
            document.getElementById('errSuppPhone').classList.add('d-none');

            var modal = new bootstrap.Modal(document.getElementById('supplierFormModal'));
            modal.show();
        }

        // 4. Mở Modal Chỉnh sửa
        function openEditSupplierModal(id, code, name, contact, phone, email, address, tax, group, products) {
            document.getElementById('supplierFormModalTitle').innerText = 'Chỉnh sửa thông tin nhà cung cấp (' + code + ')';
            document.getElementById('formSuppId').value = id;
            document.getElementById('formSuppName').value = name;
            document.getElementById('formSuppCode').value = code;
            document.getElementById('formSuppProducts').value = products || '';
            document.getElementById('formSuppContact').value = contact;
            document.getElementById('formSuppPhone').value = phone;
            document.getElementById('formSuppEmail').value = email;
            document.getElementById('formSuppAddress').value = address;
            document.getElementById('formSuppTax').value = tax;
            document.getElementById('formSuppGroup').value = group || 'Dạ & Tweed';

            document.getElementById('errSuppName').classList.add('d-none');
            document.getElementById('errSuppCode').classList.add('d-none');
            document.getElementById('errSuppProducts').classList.add('d-none');
            document.getElementById('errSuppPhone').classList.add('d-none');

            var modal = new bootstrap.Modal(document.getElementById('supplierFormModal'));
            modal.show();
        }

        // 5. Lưu thông tin nhà cung cấp (Kiểm tra ngoại lệ thiếu thông tin)
        function saveSupplier() {
            var name = document.getElementById('formSuppName').value.trim();
            var code = document.getElementById('formSuppCode').value.trim();
            var products = document.getElementById('formSuppProducts').value.trim();
            var phone = document.getElementById('formSuppPhone').value.trim();
            var contact = document.getElementById('formSuppContact').value.trim();

            var isValid = true;

            if (!name) {
                document.getElementById('errSuppName').classList.remove('d-none');
                isValid = false;
            } else {
                document.getElementById('errSuppName').classList.add('d-none');
            }

            if (!code) {
                document.getElementById('errSuppCode').classList.remove('d-none');
                isValid = false;
            } else {
                document.getElementById('errSuppCode').classList.add('d-none');
            }

            if (!products) {
                document.getElementById('errSuppProducts').classList.remove('d-none');
                isValid = false;
            } else {
                document.getElementById('errSuppProducts').classList.add('d-none');
            }

            if (!phone) {
                document.getElementById('errSuppPhone').classList.remove('d-none');
                isValid = false;
            } else {
                document.getElementById('errSuppPhone').classList.add('d-none');
            }

            if (!isValid) {
                alert('Vui lòng điền đầy đủ các thông tin bắt buộc (*)!');
                return;
            }

            var id = parseInt(document.getElementById('formSuppId').value) || 0;
            if (id === 0) {
                alert('Đã thêm thành công nhà cung cấp mới: ' + name + ' (' + code + ')!');
            } else {
                alert('Đã cập nhật thành công thông tin nhà cung cấp: ' + name + ' (' + code + ')!');
            }

            bootstrap.Modal.getInstance(document.getElementById('supplierFormModal')).hide();
        }

        // 6. Xử lý Ngừng hợp tác / Khôi phục (Ngoại lệ: Đang có phiếu nháp thì báo lỗi)
        function toggleSupplierStatus(id, name, isCurrentlyActive, hasDraft) {
            var row = document.getElementById('supp-row-' + id);
            if (!row) return;

            if (isCurrentlyActive) {
                // Kiểm tra ngoại lệ theo yêu cầu đề bài: "Ngừng hợp tác khi đang có phiếu nháp: yêu cầu xử lý các phiếu đó"
                if (hasDraft) {
                    alert('⚠️ KHÔNG THỂ NGỪNG HỢP TÁC!\n\nNhà cung cấp "' + name + '" hiện đang có 1 PHIẾU NHẬP KHO NHÁP [N10] chưa hoàn tất duyệt hoặc hủy.\n\nVui lòng xử lý hoặc xóa các phiếu nháp liên quan trước khi thực hiện ngừng hợp tác với đối tác này.');
                    return;
                }

                if (confirm('Xác nhận NGỪNG HỢP TÁC với nhà cung cấp: "' + name + '"?\n\nLưu ý:\n- Nhà cung cấp sẽ tự động bị ẩn khỏi danh sách lựa chọn khi tạo phiếu nhập mới [N10].\n- Toàn bộ lịch sử chứng từ và phiếu nhập cũ [N11/N12] vẫn được bảo lưu vĩnh viễn.')) {
                    updateSupplierStatusRow(row, false, name, id);
                }
            } else {
                if (confirm('Khôi phục KÍCH HOẠT HỢP TÁC với nhà cung cấp: "' + name + '"?')) {
                    updateSupplierStatusRow(row, true, name, id);
                }
            }
        }

        function updateSupplierStatusRow(row, isActive, name, id) {
            row.setAttribute('data-status', isActive ? 'active' : 'stopped');
            var badge = row.querySelector('.supp-status-badge');
            var btn = row.querySelector('.toggle-supp-btn');

            if (isActive) {
                if (badge) {
                    badge.className = 'badge-active supp-status-badge';
                    badge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>Đang hợp tác';
                }
                if (btn) {
                    btn.className = 'btn btn-light btn-sm text-danger border px-2 py-1 toggle-supp-btn';
                    btn.title = 'Ngừng hợp tác';
                    btn.innerHTML = '<i class="fa-solid fa-ban"></i>';
                    btn.onclick = function() { toggleSupplierStatus(id, name, true, false); };
                }
            } else {
                if (badge) {
                    badge.className = 'badge-inactive supp-status-badge';
                    badge.innerHTML = '<i class="fa-solid fa-ban me-1"></i>Ngừng hợp tác';
                }
                if (btn) {
                    btn.className = 'btn btn-light btn-sm text-success border px-2 py-1 toggle-supp-btn';
                    btn.title = 'Khôi phục hợp tác';
                    btn.innerHTML = '<i class="fa-solid fa-rotate-left"></i>';
                    btn.onclick = function() { toggleSupplierStatus(id, name, false, false); };
                }
            }
        }

        // 7. Lọc danh sách
        function filterSuppliers() {
            var kw = document.getElementById('suppSearchInput').value.toLowerCase().trim();
            var grp = document.getElementById('suppGroupFilter').value;
            var st = document.getElementById('suppStatusFilter').value;

            var rows = document.querySelectorAll('#supplierTableBody tr');
            var visible = 0;

            rows.forEach(function(row) {
                var rowGrp = row.getAttribute('data-group') || '';
                var rowSt = row.getAttribute('data-status') || '';
                var text = row.innerText.toLowerCase();

                var matchKw = (kw === '' || text.includes(kw));
                var matchGrp = (grp === '' || rowGrp.includes(grp));
                var matchSt = (st === '' || rowSt === st);

                if (matchKw && matchGrp && matchSt) {
                    row.style.display = '';
                    visible++;
                } else {
                    row.style.display = 'none';
                }
            });

            document.getElementById('visibleSuppCount').innerText = visible;
        }

        function resetSupplierFilter() {
            document.getElementById('suppSearchInput').value = '';
            document.getElementById('suppGroupFilter').value = '';
            document.getElementById('suppStatusFilter').value = '';
            filterSuppliers();
        }

        function exportSupplierData() {
            alert('Đang trích xuất toàn bộ danh sách nhà cung cấp và lịch sử nguồn hàng...');
        }
    </script>
}

