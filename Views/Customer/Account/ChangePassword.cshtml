@using System.Security.Claims
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = "Đổi mật khẩu - LIGHT LIFE";

    // Đồng bộ thông tin Sidebar bên trái từ Cookie Claims
    var currentFullName = User.FindFirst("FullName")?.Value
                          ?? User.Identity?.Name
                          ?? "Khách hàng";
    var avatarInitial = !string.IsNullOrWhiteSpace(currentFullName)
                        ? currentFullName.Trim()[0].ToString().ToUpper()
                        : "U";
    var currentEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/lightlife-account.css" asp-append-version="true" />
}

<div class="ll-account-page">
    <div class="ll-container">
        <!-- BREADCRUMB -->
        <nav class="ll-account-breadcrumb" aria-label="Đường dẫn trang">
            <a href="/">Trang chủ</a>
            <span class="ll-account-breadcrumb__sep">/</span>
            <a href="/Account/Profile">Tài khoản</a>
            <span class="ll-account-breadcrumb__sep">/</span>
            <span class="ll-account-breadcrumb__current" aria-current="page">Đổi mật khẩu</span>
        </nav>

        <div class="ll-account-layout">
            <!-- CỘT 1: SIDEBAR TÀI KHOẢN (Đã đồng bộ tên thật) -->
            <aside class="ll-account-sidebar" aria-label="Menu tài khoản cá nhân">
                <div class="ll-account-user-card">
                    <div class="ll-account-user-avatar" id="accountUserAvatar">@avatarInitial</div>
                    <div class="ll-account-user-info">
                        <span class="ll-account-user-name" id="accountUserName">@currentFullName</span>
                        <span class="ll-account-user-email" id="accountUserEmail">@currentEmail</span>
                        <span class="ll-account-user-tag">Khách hàng</span>
                    </div>
                </div>

                <nav>
                    <ul class="ll-account-nav-list">
                        <li class="ll-account-nav-item">
                            <a href="/Account/Profile"><i class="fa-regular fa-user"></i> Hồ sơ cá nhân</a>
                        </li>
                        <li class="ll-account-nav-item">
                            <a href="/Account/Addresses"><i class="fa-solid fa-location-dot"></i> Sổ địa chỉ</a>
                        </li>
                        <li class="ll-account-nav-item">
                            <a href="/Account/Orders"><i class="fa-solid fa-box-open"></i> Đơn hàng của tôi</a>
                        </li>
                        <li class="ll-account-nav-item active">
                            <a href="/Account/ChangePassword"><i class="fa-solid fa-key"></i> Đổi mật khẩu</a>
                        </li>
                        <li class="ll-account-nav-item ll-account-nav-item--logout">
                            <a href="/Account/Logout">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất
                            </a>
                        </li>
                    </ul>
                </nav>
            </aside>

            <!-- CỘT 2: NỘI DUNG ĐỔI MẬT KHẨU -->
            <main class="ll-account-content-card">
                <div class="ll-account-header">
                    <div>
                        <h1 class="ll-account-title">
                            <i class="fa-solid fa-shield-halved" style="color: var(--color-brand);"></i>
                            Đổi mật khẩu
                        </h1>
                        <p class="ll-account-desc">
                            Để bảo vệ tài khoản, vui lòng không chia sẻ mật khẩu của bạn cho bất kỳ ai khác.
                        </p>
                    </div>
                </div>

                <!-- Hiển thị thông báo lỗi từ Server C# nếu có -->
                @if (ViewBag.ErrorMessage != null)
                {
                    <div style="background-color: #fef2f2; border: 1px solid #f87171; color: #b91c1c; padding: 12px 16px; border-radius: 8px; margin-bottom: 1.25rem; font-size: 0.9rem; font-weight: 500;">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> @ViewBag.ErrorMessage
                    </div>
                }

                <!-- FORM POST CHUẨN MVC -->
                <form id="changePasswordForm" method="post" action="/Account/ChangePassword" style="max-width: 560px;" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- 1. Mật khẩu hiện tại -->
                    <div class="ll-form-group">
                        <label class="ll-form-label" for="currentPassword">
                            Mật khẩu hiện tại <span class="req">*</span>
                        </label>
                        <div class="ll-password-input-wrap" style="position: relative;">
                            <input type="password" id="currentPassword" name="CurrentPassword" class="ll-form-input" placeholder="Nhập mật khẩu đang sử dụng" required />
                            <button type="button" class="ll-password-toggle-btn" data-target="currentPassword" aria-label="Hiện mật khẩu">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span class="ll-form-error" id="currentPassError"></span>
                    </div>

                    <!-- 2. Mật khẩu mới -->
                    <div class="ll-form-group">
                        <label class="ll-form-label" for="newPassword">
                            Mật khẩu mới <span class="req">*</span>
                        </label>
                        <div class="ll-password-input-wrap" style="position: relative;">
                            <input type="password" id="newPassword" name="NewPassword" class="ll-form-input" placeholder="Nhập mật khẩu mới" required />
                            <button type="button" class="ll-password-toggle-btn" data-target="newPassword" aria-label="Hiện mật khẩu">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span class="ll-form-error" id="newPassError"></span>
                    </div>

                    <!-- Khung gợi ý độ mạnh mật khẩu realtime -->
                    <div class="ll-password-hints" style="background: #faf7f5; border: 1px solid #e8e0dc; border-radius: 8px; padding: 14px 16px; margin-bottom: 1.25rem;">
                        <div style="font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; color: #333;">
                            <i class="fa-solid fa-circle-check me-1"></i> Yêu cầu mật khẩu an toàn:
                        </div>
                        <div id="ruleLength" class="ll-password-hint-item" style="font-size: 0.8125rem; color: #666; margin-bottom: 4px;">
                            <i class="fa-solid fa-circle-notch me-1"></i> Độ dài tối thiểu từ 8 ký tự trở lên
                        </div>
                        <div id="ruleLetterNumber" class="ll-password-hint-item" style="font-size: 0.8125rem; color: #666;">
                            <i class="fa-solid fa-circle-notch me-1"></i> Chứa cả chữ cái (a-z, A-Z) và chữ số (0-9)
                        </div>
                    </div>

                    <!-- 3. Xác nhận mật khẩu mới -->
                    <div class="ll-form-group">
                        <label class="ll-form-label" for="confirmPassword">
                            Xác nhận mật khẩu mới <span class="req">*</span>
                        </label>
                        <div class="ll-password-input-wrap" style="position: relative;">
                            <input type="password" id="confirmPassword" name="ConfirmPassword" class="ll-form-input" placeholder="Nhập lại mật khẩu mới" required />
                            <button type="button" class="ll-password-toggle-btn" data-target="confirmPassword" aria-label="Hiện mật khẩu">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span class="ll-form-error" id="confirmPassError"></span>
                    </div>

                    <button type="submit" class="ll-btn-primary" id="changePassSubmitBtn"
                            style="background-color: #5c1d24; color: #fff; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer;">
                        <i class="fa-solid fa-key me-1"></i> Đổi mật khẩu
                    </button>
                </form>
            </main>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/lightlife-account.js" asp-append-version="true"></script>
}