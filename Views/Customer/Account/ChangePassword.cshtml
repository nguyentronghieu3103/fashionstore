@* Views/Account/ChangePassword.cshtml *@
@{
    Layout = "_StoreLayout";
    ViewData["Title"] = "Đổi mật khẩu - LIGHT LIFE";
}

@section Styles {
    <link rel="stylesheet" href="~/css/lightlife-account.css" asp-append-version="true" />
}

<div class="ll-account-page">
    <div class="ll-container">
        <!-- BREADCRUMB -->
        <nav class="ll-account-breadcrumb" aria-label="Đường dẫn trang">
            <a href="/">Trang chủ</a>
            <span class="ll-account-breadcrumb__sep">/</span>
            <a href="/Account/Profile">Tài khoản</a>
            <span class="ll-account-breadcrumb__sep">/</span>
            <span class="ll-account-breadcrumb__current" aria-current="page">Đổi mật khẩu</span>
        </nav>

        <div class="ll-account-layout">
            <!-- CỘT 1: SIDEBAR TÀI KHOẢN (280px) -->
            <aside class="ll-account-sidebar" aria-label="Menu tài khoản cá nhân">
                <div class="ll-account-user-card">
                    <div class="ll-account-user-avatar" id="accountUserAvatar">T</div>
                    <div class="ll-account-user-info">
                        <span class="ll-account-user-name" id="accountUserName">Nguyễn Thu Trang</span>
                        <span class="ll-account-user-email" id="accountUserEmail">thutrang@lightlife.vn</span>
                        <span class="ll-account-user-tag">Khách hàng</span>
                    </div>
                </div>

                <nav>
                    <ul class="ll-account-nav-list">
                        <li class="ll-account-nav-item">
                            <a href="/Account/Profile"><i class="fa-regular fa-user"></i> Hồ sơ cá nhân</a>
                        </li>
                        <li class="ll-account-nav-item">
                            <a href="/Account/Addresses"><i class="fa-solid fa-location-dot"></i> Sổ địa chỉ</a>
                        </li>
                        <li class="ll-account-nav-item">
                            <a href="/Account/Orders"><i class="fa-solid fa-box-open"></i> Đơn hàng của tôi</a>
                        </li>
                        <li class="ll-account-nav-item active">
                            <a href="/Account/ChangePassword"><i class="fa-solid fa-key"></i> Đổi mật khẩu</a>
                        </li>
                        <li class="ll-account-nav-item ll-account-nav-item--logout">
                            <a href="javascript:void(0)" onclick="LightLifeAuth.logout();">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất
                            </a>
                        </li>
                    </ul>
                </nav>
            </aside>

            <!-- CỘT 2: NỘI DUNG ĐỔI MẬT KHẨU -->
            <main class="ll-account-content-card">
                <div class="ll-account-header">
                    <div>
                        <h1 class="ll-account-title">
                            <i class="fa-solid fa-shield-halved" style="color: var(--color-brand);"></i>
                            Đổi mật khẩu
                        </h1>
                        <p class="ll-account-desc">
                            Để bảo vệ tài khoản, vui lòng không chia sẻ mật khẩu của bạn cho bất kỳ ai khác.
                        </p>
                    </div>
                </div>

                <form id="changePasswordForm" novalidate style="max-width: 520px;">
                    <!-- Mật khẩu hiện tại -->
                    <div class="ll-form-group">
                        <label class="ll-form-label" for="currentPassword">
                            Mật khẩu hiện tại <span class="req">*</span>
                        </label>
                        <div class="ll-input-wrapper">
                            <input type="password" id="currentPassword" class="ll-form-input" placeholder="Nhập mật khẩu đang sử dụng" autocomplete="current-password" required />
                            <button type="button" class="ll-password-toggle-btn" data-target="currentPassword" aria-label="Hiện mật khẩu">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span class="ll-form-error-msg" id="currentPassError"></span>
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="ll-form-group">
                        <label class="ll-form-label" for="newPassword">
                            Mật khẩu mới <span class="req">*</span>
                        </label>
                        <div class="ll-input-wrapper">
                            <input type="password" id="newPassword" class="ll-form-input" placeholder="Nhập mật khẩu mới" autocomplete="new-password" required />
                            <button type="button" class="ll-password-toggle-btn" data-target="newPassword" aria-label="Hiện mật khẩu">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span class="ll-form-error-msg" id="newPassError"></span>
                    </div>

                    <!-- Hướng dẫn độ mạnh mật khẩu -->
                    <div class="ll-password-hint-box">
                        <div class="ll-password-hint-title">
                            <i class="fa-solid fa-circle-check"></i> Yêu cầu mật khẩu an toàn:
                        </div>
                        <ul class="ll-password-hint-list">
                            <li class="ll-password-hint-item" id="ruleLength">
                                <i class="fa-solid fa-circle-notch"></i> Độ dài tối thiểu từ 8 ký tự trở lên
                            </li>
                            <li class="ll-password-hint-item" id="ruleLetterNumber">
                                <i class="fa-solid fa-circle-notch"></i> Chứa cả chữ cái (a-z, A-Z) và chữ số (0-9)
                            </li>
                        </ul>
                    </div>

                    <!-- Xác nhận mật khẩu mới -->
                    <div class="ll-form-group">
                        <label class="ll-form-label" for="confirmPassword">
                            Xác nhận mật khẩu mới <span class="req">*</span>
                        </label>
                        <div class="ll-input-wrapper">
                            <input type="password" id="confirmPassword" class="ll-form-input" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" required />
                            <button type="button" class="ll-password-toggle-btn" data-target="confirmPassword" aria-label="Hiện mật khẩu">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span class="ll-form-error-msg" id="confirmPassError"></span>
                    </div>

                    <!-- Nút Đổi Mật Khẩu -->
                    <div style="margin-top: 2rem;">
                        <button type="submit" class="ll-btn-save" id="changePassSubmitBtn">
                            <i class="fa-solid fa-key"></i> Đổi mật khẩu
                        </button>
                    </div>
                </form>
            </main>
        </div>
    </div>
</div>

<!-- ==========================================================================
     MODAL: THÔNG BÁO YÊU CẦU ĐĂNG NHẬP LẠI (NẾU BACKEND YÊU CẦU)
     ========================================================================== -->
<div class="ll-modal-overlay" id="reloginNoticeModal" role="dialog" aria-modal="true" aria-labelledby="reloginModalTitle">
    <div class="ll-modal-dialog--address" style="max-width: 460px; text-align: center;">
        <div style="width: 60px; height: 60px; border-radius: 50%; background: #E8F5E9; color: var(--color-success); display: inline-flex; align-items: center; justify-content: center; font-size: 1.75rem; margin-bottom: 1rem;">
            <i class="fa-solid fa-shield-check"></i>
        </div>
        <h3 class="ll-modal-title" style="margin-bottom: 0.5rem;" id="reloginModalTitle">Mật khẩu đã được cập nhật!</h3>
        <p style="font-size: 0.875rem; color: var(--color-text-sub); line-height: 1.6; margin: 0 0 1.5rem 0;">
            Vì lý do bảo mật tài khoản, mọi phiên đăng nhập cũ đã được đăng xuất an toàn. Vui lòng đăng nhập lại với mật khẩu mới.
        </p>
        <div style="display: flex; justify-content: center;">
            <a href="/Account/Login" class="ll-btn-save" style="text-decoration: none;">
                <i class="fa-solid fa-arrow-right-to-bracket"></i> Đăng nhập ngay
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/lightlife-account.js" asp-append-version="true"></script>
}

