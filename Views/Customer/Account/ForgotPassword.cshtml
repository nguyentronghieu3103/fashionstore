@* Views/Account/ForgotPassword.cshtml *@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Quên mật khẩu - LIGHT LIFE";
}

<div class="ll-auth-card">
    <!-- CỘT 1: ẢNH EDITORIAL THỜI TRANG (DESKTOP) -->
    <div class="ll-auth-visual ll-auth-visual--forgot">
        <div>
            <a href="/" class="ll-auth-brand" title="Về trang chủ LIGHT LIFE">
                <img src="~/images/logo.png" alt="LIGHT LIFE Logo" class="ll-auth-brand__img" />
                <div>
                    <span class="ll-auth-brand__title">LIGHT LIFE</span>
                    <span class="ll-auth-brand__sub">FASHION STUDIO</span>
                </div>
            </a>
        </div>

        <div class="ll-auth-quote">
            <p class="ll-auth-quote__text">
                "Thời trang không nhất thiết phải đến từ nhãn mác. Nó đến từ chính tâm hồn và cách bạn yêu thương bản thân."
            </p>
            <span class="ll-auth-quote__author">— Ralph Lauren</span>
        </div>

        <div>
            <a href="/" class="ll-auth-back-link">
                <i class="fa-solid fa-arrow-left"></i> Quay lại cửa hàng
            </a>
        </div>
    </div>

    <!-- CỘT 2: BIỂU MẪU YÊU CẦU ĐẶT LẠI MẬT KHẨU -->
    <div class="ll-auth-form-wrap">
        <div>
            <!-- Logo hiển thị trên Mobile -->
            <a href="/" class="ll-auth-mobile-brand">
                <img src="~/images/logo.png" alt="LIGHT LIFE Logo" />
                <span class="fw-bold fs-5">LIGHT LIFE</span>
            </a>

            <div class="ll-auth-header">
                <h1 class="ll-auth-header__title">Khôi Phục Mật Khẩu</h1>
                <p class="ll-auth-header__subtitle">
                    Nhập email đã đăng ký của bạn. Chúng tôi sẽ gửi hướng dẫn bảo mật để bạn thiết lập lại mật khẩu mới.
                </p>
            </div>

            <!-- Banner thông báo lỗi / thành công (Phản hồi trung tính khi thành công) -->
            <div class="ll-auth-alert" id="authAlert" role="alert">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span id="authAlertText">Thông báo khôi phục mật khẩu.</span>
            </div>

            <!-- Biểu mẫu gửi email -->
            <form id="forgotForm" novalidate>
                <!-- Email tài khoản -->
                <div class="ll-form-group">
                    <label for="forgotEmail" class="ll-form-label">Địa chỉ Email tài khoản *</label>
                    <div class="ll-input-wrapper">
                        <span class="ll-input-icon"><i class="fa-regular fa-envelope"></i></span>
                        <input type="email" 
                               id="forgotEmail" 
                               name="email"
                               class="ll-input-field" 
                               placeholder="VD: emailcuaban@gmail.com" 
                               autocomplete="email" 
                               required />
                    </div>
                    <span class="ll-field-error" id="forgotEmailError"></span>
                </div>

                <div class="ll-password-hint" style="margin-bottom: 1.5rem;">
                    <i class="fa-solid fa-shield-halved" style="color: var(--color-gold); margin-right: 4px;"></i>
                    Hệ thống sẽ gửi một liên kết bảo mật có thời hạn sử dụng trong 15 phút.
                </div>

                <!-- Nút Gửi hướng dẫn -->
                <button type="submit" class="ll-auth-submit-btn" id="forgotSubmitBtn">
                    <i class="fa-solid fa-paper-plane"></i> Gửi hướng dẫn khôi phục
                </button>
            </form>
        </div>

        <!-- Chân form: Quay lại Đăng nhập -->
        <footer class="ll-auth-footer">
            <span>Bạn đã nhớ mật khẩu? </span>
            <a href="/Account/Login">Quay lại Đăng nhập</a>
        </footer>
    </div>
</div>

