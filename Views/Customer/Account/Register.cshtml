@model fashionstore.Models.Dtos.RegisterRequestDto
@* Views/Account/Register.cshtml *@
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng ký tài khoản - LIGHT LIFE";
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}

<div class="ll-auth-card">
    <!-- CỘT 1: ẢNH EDITORIAL THỜI TRANG (DESKTOP) - GIỮ NGUYÊN 100% -->
    <div class="ll-auth-visual ll-auth-visual--register">
        <div>
            <a href="/" class="ll-auth-brand" title="Về trang chủ LIGHT LIFE">
                <img src="~/images/logo.png" alt="LIGHT LIFE Logo" class="ll-auth-brand__img" />
                <div>
                    <span class="ll-auth-brand__title">LIGHT LIFE</span>
                    <span class="ll-auth-brand__sub">FASHION STUDIO</span>
                </div>
            </a>
        </div>

        <div class="ll-auth-quote">
            <p class="ll-auth-quote__text">
                "Sự đơn giản là chìa khóa của mọi vẻ đẹp thanh lịch đích thực."
            </p>
            <span class="ll-auth-quote__author">— Coco Chanel</span>
        </div>

        <div>
            <a href="/" class="ll-auth-back-link">
                <i class="fa-solid fa-arrow-left"></i> Quay lại cửa hàng
            </a>
        </div>
    </div>

    <!-- CỘT 2: BIỂU MẪU ĐĂNG KÝ KHÁCH HÀNG -->
    <div class="ll-auth-form-wrap">
        <div>
            <!-- Logo hiển thị trên Mobile -->
            <a href="/" class="ll-auth-mobile-brand">
                <img src="~/images/logo.png" alt="LIGHT LIFE Logo" />
                <span class="fw-bold fs-5">LIGHT LIFE</span>
            </a>

            <div class="ll-auth-header">
                <h1 class="ll-auth-header__title">Tạo Tài Khoản</h1>
            </div>

            <!-- Banner thông báo lỗi tự động hiện lên khi có lỗi từ Server -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="ll-auth-alert show ll-auth-alert--error" role="alert" style="display: flex;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <div asp-validation-summary="All" style="display: inline-block;"></div>
                </div>
            }

            <!-- Biểu mẫu đăng ký chuẩn Form POST của MVC -->
            <form asp-controller="Account" asp-action="Register" method="post" id="registerForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" value="@returnUrl" />

                <!-- 1. Họ và tên -->
                <div class="ll-form-group">
                    <label asp-for="FullName" class="ll-form-label">Họ và tên của bạn *</label>
                    <div class="ll-input-wrapper">
                        <span class="ll-input-icon"><i class="fa-regular fa-user"></i></span>
                        <input asp-for="FullName"
                               id="regFullName"
                               class="ll-input-field"
                               placeholder="VD: Nguyễn Thu Trang"
                               autocomplete="name"
                               required />
                    </div>
                    <span asp-validation-for="FullName" class="ll-field-error show"></span>
                </div>

                <!-- 2. Email đăng ký -->
                <div class="ll-form-group">
                    <label asp-for="Email" class="ll-form-label">Địa chỉ Email *</label>
                    <div class="ll-input-wrapper">
                        <span class="ll-input-icon"><i class="fa-regular fa-envelope"></i></span>
                        <input asp-for="Email"
                               type="email"
                               id="regEmail"
                               class="ll-input-field"
                               placeholder="VD: thutrang@example.com"
                               autocomplete="email"
                               required />
                    </div>
                    <span asp-validation-for="Email" class="ll-field-error show"></span>
                </div>

                <!-- 3. Mật khẩu -->
                <div class="ll-form-group">
                    <label asp-for="Password" class="ll-form-label">Mật khẩu *</label>
                    <div class="ll-input-wrapper">
                        <span class="ll-input-icon"><i class="fa-solid fa-lock"></i></span>
                        <input asp-for="Password"
                               type="password"
                               id="regPassword"
                               class="ll-input-field ll-input-field--has-toggle"
                               placeholder="Tối thiểu 8 ký tự"
                               autocomplete="new-password"
                               required />
                        <button type="button"
                                class="ll-password-toggle-btn"
                                data-target="regPassword"
                                aria-label="Hiện mật khẩu">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                    <div class="ll-password-hint">Gợi ý: Mật khẩu nên gồm ít nhất 8 ký tự, kết hợp chữ và số.</div>
                    <span asp-validation-for="Password" class="ll-field-error show"></span>
                </div>

                <!-- 4. Xác nhận mật khẩu -->
                <div class="ll-form-group">
                    <label asp-for="ConfirmPassword" class="ll-form-label">Xác nhận lại mật khẩu *</label>
                    <div class="ll-input-wrapper">
                        <span class="ll-input-icon"><i class="fa-solid fa-shield-halved"></i></span>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               id="regConfirmPassword"
                               class="ll-input-field ll-input-field--has-toggle"
                               placeholder="Nhập lại mật khẩu vừa nhập"
                               autocomplete="new-password"
                               required />
                        <button type="button"
                                class="ll-password-toggle-btn"
                                data-target="regConfirmPassword"
                                aria-label="Hiện mật khẩu">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="ll-field-error show"></span>
                </div>
                <!-- 6. Nút Đăng ký chính -->
                <button type="submit" class="ll-auth-submit-btn" id="regSubmitBtn">
                    <i class="fa-solid fa-user-plus"></i> Đăng ký tài khoản
                </button>
            </form>

            <!-- Phân cách hoặc -->
            <div class="ll-auth-divider">
                <span>hoặc đăng ký nhanh với</span>
            </div>

            <!-- 7. Nút Đăng ký bằng Google (Nối thẳng vào pipeline OAuth bạn đã hoàn thành!) -->
            <form asp-controller="Account" asp-action="ExternalLogin" asp-route-returnUrl="@returnUrl" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="ll-google-btn" title="Đăng ký tài khoản nhanh qua Google">
                    <svg width="20" height="20" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z" />
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z" />
                        <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.14-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.98 0 12s.45 3.82 1.25 5.42l4.03-3.15z" />
                        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z" />
                    </svg>
                    <span>Đăng ký bằng Google</span>
                </button>
            </form>
        </div>

        <!-- Chân form: Liên kết Đăng nhập -->
        <footer class="ll-auth-footer">
            <span>Đã có tài khoản khách hàng? </span>
            <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(returnUrl)">Đăng nhập ngay</a>
        </footer>
    </div>
</div>