@* Views/Account/ResetPassword.cshtml *@
@model fashionstore.Models.Dtos.ResetPasswordRequestDto
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đặt lại mật khẩu - LIGHT LIFE";

    // Lấy token và email từ Model hoặc ViewData (đảm bảo không bị null)
    var token = Model?.Token ?? ViewData["Token"] as string ?? "";
    var email = Model?.Email ?? ViewData["Email"] as string ?? "";

    // Kiểm tra xem có lỗi từ Server C# không
    var hasError = ViewBag.ErrorMessage != null;
    var alertClass = hasError ? "ll-auth-alert--error show" : "";
    var alertMessage = ViewBag.ErrorMessage ?? "Thông báo cập nhật mật khẩu.";
}

<div class="ll-auth-card">
    <!-- CỘT 1: ẢNH EDITORIAL THỜI TRANG (DESKTOP) -->
    <div class="ll-auth-visual ll-auth-visual--forgot">
        <div>
            <a href="/" class="ll-auth-brand" title="Về trang chủ LIGHT LIFE">
                <img src="~/images/logo.png" alt="LIGHT LIFE Logo" class="ll-auth-brand__img" />
                <div>
                    <span class="ll-auth-brand__title">LIGHT LIFE</span>
                    <span class="ll-auth-brand__sub">FASHION STUDIO</span>
                </div>
            </a>
        </div>

        <div class="ll-auth-quote">
            <p class="ll-auth-quote__text">
                "Bảo vệ tài khoản và sự an tâm của khách hàng là ưu tiên hàng đầu tại LIGHT LIFE."
            </p>
            <span class="ll-auth-quote__author">— LIGHT LIFE Studio</span>
        </div>

        <div>
            <a href="/" class="ll-auth-back-link">
                <i class="fa-solid fa-arrow-left"></i> Quay lại cửa hàng
            </a>
        </div>
    </div>

    <!-- CỘT 2: BIỂU MẪU ĐẶT LẠI MẬT KHẨU MỚI -->
    <div class="ll-auth-form-wrap">
        <div>
            <!-- Logo hiển thị trên Mobile -->
            <a href="/" class="ll-auth-mobile-brand">
                <img src="~/images/logo.png" alt="LIGHT LIFE Logo" />
                <span class="fw-bold fs-5">LIGHT LIFE</span>
            </a>

            <div class="ll-auth-header">
                <h1 class="ll-auth-header__title">Đặt Lại Mật Khẩu</h1>
                <p class="ll-auth-header__subtitle">
                    Nhập mật khẩu mới an toàn cho tài khoản: <strong style="color: var(--color-brand, #5c1d24);">@email</strong>
                </p>
            </div>

            <!-- TẬN DỤNG KHUNG BANNER SẴN CÓ: Bật hiển thị nếu Server phát hiện lỗi -->
            <div class="ll-auth-alert @alertClass" id="authAlert" role="alert">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span id="authAlertText">@alertMessage</span>
            </div>

            <!-- BIỂU MẪU: Đã thêm method="post" và action="/Account/ResetPassword" -->
            <form id="resetPasswordForm" method="post" action="/Account/ResetPassword" novalidate>
                @Html.AntiForgeryToken()

                <!-- Giữ nguyên 2 input ẩn Token và Email để C# biết ai đang đổi -->
                <input type="hidden" id="resetToken" name="token" value="@token" />
                <input type="hidden" id="resetEmail" name="email" value="@email" />

                <!-- Mật khẩu mới -->
                <div class="ll-form-group">
                    <label for="resetNewPassword" class="ll-form-label">Mật khẩu mới *</label>
                    <div class="ll-input-wrapper">
                        <span class="ll-input-icon"><i class="fa-solid fa-lock"></i></span>
                        <input type="password"
                               id="resetNewPassword"
                               name="newPassword"
                               class="ll-input-field ll-input-field--has-toggle"
                               placeholder="Tối thiểu 8 ký tự, gồm chữ và số"
                               autocomplete="new-password"
                               required />
                        <button type="button"
                                class="ll-password-toggle-btn"
                                data-target="resetNewPassword"
                                aria-label="Hiện mật khẩu">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                    <div class="ll-password-hint">Gợi ý: Mật khẩu từ 8 ký tự trở lên, kết hợp chữ cái và chữ số.</div>
                    <span class="ll-field-error" id="resetNewPasswordError"></span>
                </div>

                <!-- Xác nhận mật khẩu mới -->
                <div class="ll-form-group">
                    <label for="resetConfirmPassword" class="ll-form-label">Xác nhận mật khẩu mới *</label>
                    <div class="ll-input-wrapper">
                        <span class="ll-input-icon"><i class="fa-solid fa-shield-halved"></i></span>
                        <input type="password"
                               id="resetConfirmPassword"
                               name="confirmPassword"
                               class="ll-input-field ll-input-field--has-toggle"
                               placeholder="Nhập lại mật khẩu mới"
                               autocomplete="new-password"
                               required />
                        <button type="button"
                                class="ll-password-toggle-btn"
                                data-target="resetConfirmPassword"
                                aria-label="Hiện mật khẩu">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                    <span class="ll-field-error" id="resetConfirmPasswordError"></span>
                </div>

                <!-- Nút Cập nhật -->
                <button type="submit" class="ll-auth-submit-btn" id="resetSubmitBtn">
                    Cập nhật mật khẩu mới
                </button>
            </form>
        </div>

        <!-- Chân form: Quay lại Đăng nhập -->
        <footer class="ll-auth-footer">
            <span>Đã nhớ mật khẩu cũ? </span>
            <a href="/Account/Login">Quay lại Đăng nhập</a>
        </footer>
    </div>
</div>