@{
    ViewData["Title"] = "Trang chủ - LIGHT LIFE Fashion Studio";
}

<!-- ==========================================================================
     KHUNG 2: HERO GIỚI THIỆU BỘ SƯU TẬP (Kế thừa nhận diện & bố cục Home)
     ========================================================================== -->
<section class="ll-hero">
    <div class="ll-container">
        <div class="ll-hero-grid">
            <!-- Nội dung giới thiệu bên trái -->
            <div>
                <span class="ll-hero-badge">Bộ Sưu Tập Mới 2026</span>
                <h1 class="ll-hero-title">Phong Cách Thời Trang Tinh Tế & Hiện Đại</h1>
                <p class="ll-hero-desc">
                    Khám phá các thiết kế mới nhất với chất liệu cao cấp, đường may tỉ mỉ và phong cách dẫn đầu xu hướng. Tự tin khẳng định khí chất trong mọi khoảnh khắc thường nhật.
                </p>
                <div class="ll-hero-actions">
                    <!-- Nối hành vi: Khám phá ngay → Danh sách sản phẩm -->
                    <a href="/Products" class="ll-btn ll-btn-primary">
                        <i class="fa-solid fa-compass"></i> Khám phá ngay
                    </a>
                    <!-- Nối hành vi phụ: Xem hàng mới về -->
                    <a href="/Products?sort=newest" class="ll-btn ll-btn-secondary">
                        <i class="fa-solid fa-sparkles"></i> Hàng mới về
                    </a>
                </div>
            </div>

            <!-- Banner hình ảnh bên phải (Bo góc 8px, bóng nhẹ) -->
            <div>
                <div class="ll-hero-banner-card">
                    <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=1000&auto=format&fit=crop" 
                         alt="Bộ sưu tập thời trang Light Life 2026" 
                         class="ll-hero-img" />
                </div>
            </div>
        </div>
    </div>
</section>

