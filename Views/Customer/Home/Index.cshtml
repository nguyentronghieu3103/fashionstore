<!-- ==========================================================================
     KHUNG 6: THÔNG TIN CHÍNH SÁCH (Kế thừa từ Home hiện tại)
     ========================================================================== -->
<section class="ll-section" id="policies">
    <div class="ll-container">
        <div class="ll-section-header" style="justify-content: center; text-align: center; margin-bottom: 40px;">
            <div class="ll-section-title-wrap">
                <span class="ll-section-eyebrow">Cam Kết Khách Hàng</span>
                <h2 class="ll-section-title">Chính Sách & Dịch Vụ Của Light Life</h2>
            </div>
        </div>

        <div class="ll-policies-grid">
            <!-- Chính sách 1: Giao hàng toàn quốc -->
            <div class="ll-policy-card">
                <div class="ll-policy-icon-box">
                    <i class="fa-solid fa-truck-fast"></i>
                </div>
                <h3 class="ll-policy-title">Giao Hàng Toàn Quốc</h3>
                <p class="ll-policy-desc">
                    Miễn phí giao hàng cho đơn từ 500.000 đ. Nhận hàng kiểm tra thanh toán COD hoặc chuyển khoản.
                </p>
            </div>

            <!-- Chính sách 2: Đổi trả 7 ngày -->
            <div class="ll-policy-card">
                <div class="ll-policy-icon-box">
                    <i class="fa-solid fa-arrow-rotate-left"></i>
                </div>
                <h3 class="ll-policy-title">Đổi Trả Trong 7 Ngày</h3>
                <p class="ll-policy-desc">
                    Hỗ trợ đổi size hoặc đổi mẫu linh hoạt và tiện lợi nếu sản phẩm còn nguyên tem mác.
                </p>
            </div>

            <!-- Chính sách 3: Cam kết chất lượng -->
            <div class="ll-policy-card">
                <div class="ll-policy-icon-box">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3 class="ll-policy-title">Cam Kết Chất Lượng 100%</h3>
                <p class="ll-policy-desc">
                    Chất liệu vải tinh tuyển cao cấp với tiêu chuẩn may tỉ mỉ, phom dáng chuẩn mực người Việt.
                </p>
            </div>

            <!-- Chính sách 4: Tư vấn & Hỗ trợ -->
            <div class="ll-policy-card">
                <div class="ll-policy-icon-box">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <h3 class="ll-policy-title">Tư Vấn Tận Tâm 24/7</h3>
                <p class="ll-policy-desc">
                    Hotline 1900 6868 luôn sẵn sàng hỗ trợ chọn size, tư vấn phối đồ và theo dõi hành trình đơn hàng.
                </p>
            </div>
        </div>
    </div>
</section>

