                <li>
                    <label class="ll-filter-item-label">
                        <span class="ll-filter-radio-box">
                            <input type="radio" name="price_filter" value="all" checked />
                            <span>Tất cả mức giá</span>
                        </span>
                    </label>
                </li>
                <li>
                    <label class="ll-filter-item-label">
                        <span class="ll-filter-radio-box">
                            <input type="radio" name="price_filter" value="under300" />
                            <span>Dưới 300.000 đ</span>
                        </span>
                    </label>
                </li>
                <li>
                    <label class="ll-filter-item-label">
                        <span class="ll-filter-radio-box">
                            <input type="radio" name="price_filter" value="300-600" />
                            <span>300.000 đ - 600.000 đ</span>
                        </span>
                    </label>
                </li>
                <li>
                    <label class="ll-filter-item-label">
                        <span class="ll-filter-radio-box">
                            <input type="radio" name="price_filter" value="600-1000" />
                            <span>600.000 đ - 1.000.000 đ</span>
                        </span>
                    </label>
                </li>
                <li>
                    <label class="ll-filter-item-label">
                        <span class="ll-filter-radio-box">
                            <input type="radio" name="price_filter" value="over1000" />
                            <span>Trên 1.000.000 đ</span>
                        </span>
                    </label>
                </li>
            </ul>
        </div>

        <!-- Nhóm 3: Màu sắc -->
        <div class="ll-filter-group">
            <h3 class="ll-filter-heading">Màu Sắc</h3>
