    <!-- Nút hành động trong Drawer -->
    <div class="ll-drawer-footer">
        <button type="button" class="ll-btn ll-btn-secondary" id="llDrawerResetBtn">
            Đặt lại
        </button>
        <button type="button" class="ll-btn ll-btn-primary" id="llDrawerApplyBtn">
            Áp dụng
        </button>
    </div>
</aside>

@section Scripts {
    <!-- Script Quản lý Catalog & Lọc Đa Chiều -->
    <script src="~/js/lightlife-products.js" asp-append-version="true"></script>
}

