@section Scripts {
    <script>
        var isShiftOpen = true;

        // Toggle trạng thái ca làm việc
        function toggleShiftState(isOpen) {
            isShiftOpen = isOpen;
            sessionStorage.setItem('currentShiftState', isOpen ? 'open' : 'closed');
            var tag = document.getElementById('shiftStatusTag');
            var alertBox = document.getElementById('shiftClosedAlert');
            var topbarBadge = document.getElementById('topbarShiftBadge');
            var cashWidget = document.getElementById('shiftCashWidget');
            var btnGroup = document.getElementById('btnShiftActionsGroup');

            if (isOpen) {
                tag.className = 'badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small';
                tag.innerHTML = 'Đang trong ca';
                alertBox.classList.add('d-none');
                if (topbarBadge) {
                    topbarBadge.className = 'badge bg-success-subtle text-success border border-success-subtle small px-2 py-1';
                    topbarBadge.innerHTML = '<i class="fa-solid fa-circle text-success me-1" style="font-size: 0.45rem;"></i>Ca đang mở';
                }
                if (cashWidget) cashWidget.classList.remove('opacity-50');
                btnGroup.innerHTML = `
                    <button type="button" class="btn btn-dark px-4 py-2 fw-semibold rounded-pill d-inline-flex align-items-center gap-2 shadow-sm" onclick="openPosSale()" id="btnMainSaleAction">
                        <i class="fa-solid fa-cash-register"></i>
                        <span>Bán hàng POS</span>
                        <span class="badge bg-white text-dark rounded-pill px-2 py-0 fw-bold d-none d-md-inline" style="font-size: 0.72rem;">F1</span>
                    </button>
                `;
            } else {
                tag.className = 'badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 small';
                tag.innerHTML = 'Chưa mở ca';
                alertBox.classList.remove('d-none');
                if (topbarBadge) {
                    topbarBadge.className = 'badge bg-warning-subtle text-warning border border-warning-subtle small px-2 py-1';
                    topbarBadge.innerHTML = '<i class="fa-solid fa-circle text-warning me-1" style="font-size: 0.45rem;"></i>Chưa mở ca';
                }
                if (cashWidget) cashWidget.classList.add('opacity-50');
                btnGroup.innerHTML = `
                    <a href="@Url.Action("Open", "Shifts", new { area = "Employee" })" class="btn btn-dark px-4 py-2 fw-semibold rounded-pill shadow-sm text-decoration-none">
                        <i class="fa-solid fa-door-open me-1"></i> Mở ca bán hàng
                    </a>
                `;
            }
        }

        // Mở POS bán hàng - Chặn nếu chưa mở ca
        function openPosSale() {
            if (!isShiftOpen) {
                alert('⚠️ Ca làm việc chưa mở! Vui lòng khai báo tiền đầu ca và bấm [Mở ca bán hàng] trước khi bán hàng tại quầy.');
                openStartShiftModal();
                return;
            }
            window.location.href = '@Url.Action("Index", "Pos", new { area = "Employee" })';
        }

        // Mở trang Mở ca bán hàng
        function openStartShiftModal() {
            window.location.href = '@Url.Action("Open", "Shifts", new { area = "Employee" })';
        }

        // Xác nhận Mở ca
        function confirmStartShift() {
            var cash = document.getElementById('startShiftCash').value;
            alert('✅ ĐÃ MỞ CA THÀNH CÔNG:\n\nNhân viên: Lê Minh Nhật\nTiền đầu ca: ' + Number(cash).toLocaleString('vi-VN') + ' VNĐ.\nBây giờ bạn có thể bắt đầu quét thanh toán tại POS.');
            var modalEl = document.getElementById('startShiftModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
            
            document.getElementById('shiftToggleSwitch').checked = true;
            toggleShiftState(true);
        }

        // Mở màn hình Đóng ca & Bàn giao
        function openCloseShiftModal() {
            if (!isShiftOpen) {
                alert('Ca làm việc đang đóng!');
                return;
            }
            window.location.href = '@Url.Action("Close", "Shifts", new { area = "Employee" })';
        }

        // Tính chênh lệch tiền két
        function calculateCashDiff() {
            var actual = Number(document.getElementById('actualCashCount').value || 0);
            var expected = 9450000;
            var diff = actual - expected;
            var diffBox = document.getElementById('diffAlertBox');

            if (diff === 0) {
                diffBox.className = 'p-2 rounded bg-success-subtle text-success border border-success-subtle small fw-bold';
                diffBox.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i>Khớp hoàn toàn (0₫)';
            } else if (diff > 0) {
                diffBox.className = 'p-2 rounded bg-warning-subtle text-warning-emphasis border border-warning-subtle small fw-bold';
                diffBox.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i>Thừa tiền két: +' + diff.toLocaleString('vi-VN') + '₫';
            } else {
                diffBox.className = 'p-2 rounded bg-danger-subtle text-danger border border-danger-subtle small fw-bold';
                diffBox.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i>Thiếu tiền két: ' + diff.toLocaleString('vi-VN') + '₫ (Cần giải trình)';
            }
        }

        // Gửi kết quả đóng ca lên Quản lý soát ca
        function submitCloseShift() {
            var actual = Number(document.getElementById('actualCashCount').value || 0);
            var expected = 9450000;
            var diff = actual - expected;
            var note = document.getElementById('shiftCloseNote').value;

            var msg = 'ĐÃ GỬI BÁO CÁO KẾT CA THÀNH CÔNG:\n\n- Tiền thực đếm: ' + actual.toLocaleString('vi-VN') + '₫\n- Tiền lý thuyết: ' + expected.toLocaleString('vi-VN') + '₫';
            if (diff !== 0) {
                msg += '\n- Chênh lệch két: ' + (diff > 0 ? '+' : '') + diff.toLocaleString('vi-VN') + '₫\n- Ghi chú: ' + (note || '(Không có)');
            }
            msg += '\n\nDữ liệu đối soát đã được lưu vào hệ thống!';
            alert(msg);

            var modalEl = document.getElementById('closeShiftModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            toggleShiftState(false);
        }

        // Hoàn tất bán hàng
        function finishSale(method) {
            alert('✅ THANH TOÁN THÀNH CÔNG!\n\nPhương thức: ' + method + '\nTổng tiền: 3.300.000₫\nĐã in hóa đơn và cộng vào doanh thu ca.');
            var modalEl = document.getElementById('posSaleModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        }

        // Chuyển tab công việc
        function switchTaskTab(targetTabId, cardEl) {
            var tabBtnId = targetTabId + '-btn';
            var triggerEl = document.getElementById(tabBtnId);
            if (triggerEl) {
                var tab = new bootstrap.Tab(triggerEl);
                tab.show();
            }

            document.querySelectorAll('.emp-stat-card').forEach(function(el) {
                el.classList.remove('active-tab');
            });
            if (cardEl) cardEl.classList.add('active-tab');
        }

        // Mở modal xử lý đơn online
        function openOnlineOrderModal(code) {
            var modal = new bootstrap.Modal(document.getElementById('onlineModal'));
            modal.show();
        }

        // Bàn giao bưu tá
        function handoverShipper(code) {
            alert('Đã cập nhật: Đơn hàng ' + code + ' đã bàn giao cho bưu tá thành công.');
        }

        // Xác nhận đóng gói & in tem
        function confirmPackAndPrint() {
            alert('✅ ĐÃ HOÀN TẤT ĐÓNG GÓI:\n\nĐã in mã vận đơn và chuyển sang trạng thái "Chờ bàn giao bưu tá".');
            var modalEl = document.getElementById('onlineModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
        }

        // Tra tồn kho
        function openStockLookupModal() {
            var modal = new bootstrap.Modal(document.getElementById('stockLookupModal'));
            modal.show();
        }

        // Tạo phiếu nhập
        function openCreateImportModal() {
            alert('Mở biểu mẫu Lập phiếu nhập vải / hàng mới gửi Quản lý phê duyệt.');
        }

        // Kiểm kê kho
        function openStockAuditModal() {
            alert('Mở màn hình Nhập số lượng đếm kiểm kê thực tế tại kệ.');
        }

        // Xem phiếu nhập
        function viewImportSlip(code) {
            alert('Chi tiết phiếu ' + code + ':\n- NCC: Bảo Nam Silk\n- Mặt hàng: 40 cây vải lụa Satin\n- Trạng thái: Chờ Quản lý phê duyệt.');
        }

        // Xem phiếu kiểm kê
        function viewAuditSlip(code) {
            alert('Bảng kiểm kê ' + code + ':\n- Phạm vi: Áo khoác & Blazer\n- Tồn sổ: 50 | Thực đếm: 48 (Lệch -2)\n- Trạng thái: Đã gửi Quản lý cân đối tồn.');
        }

        // Thông tin đổi trả
        function showReturnsInfo() {
            openReturnsPage();
        }

        // Mở trang Tạo yêu cầu đổi / trả
        function openReturnsPage() {
            window.location.href = '@Url.Action("Returns", "Dashboard", new { area = "Employee" })';
        }

        // Mở trang danh sách hóa đơn
        function openInvoicesPage() {
            window.location.href = '@Url.Action("Index", "Invoices", new { area = "Employee" })';
        }

        // Mở trang Công việc kho
        function openWarehousePage() {
            window.location.href = '@Url.Action("Index", "Warehouse", new { area = "Employee" })';
        }

        // Trigger từ Sidebar
        function quickActionTrigger(action) {
            switch(action) {
                case 'pos': openPosSale(); break;
                case 'invoices': openInvoicesPage(); break;
                case 'close_shift': openCloseShiftModal(); break;
                case 'online': switchTaskTab('tab-online'); break;
                case 'stock': openStockLookupModal(); break;
                case 'warehouse_tasks': openWarehousePage(); break;
                default: break;
            }
        }

        // Tự động đồng bộ trạng thái khi tải trang
        window.addEventListener('DOMContentLoaded', function() {
            var saved = sessionStorage.getItem('currentShiftState');
            if (saved === 'closed') {
                toggleShiftState(false);
            } else {
                toggleShiftState(true);
            }
        });

        // Phím tắt tác vụ nhanh cho nhân viên quầy (F1: POS, F2: Tra kho)
        document.addEventListener('keydown', function(e) {
            if (e.key === 'F1') {
                e.preventDefault();
                openPosSale();
            } else if (e.key === 'F2') {
                e.preventDefault();
                openStockLookupModal();
            }
        });
    </script>
}

