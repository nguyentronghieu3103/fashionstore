                notes: 'Hàng điều chuyển nội bộ Thu Đông đợt 2, đã kiểm đếm và ghi sổ kho.',
                totalReceived: 25,
                totalDefect: 0,
                items: [
                    { sku: 'TWD-BLK-M', name: 'Áo Khoác Dạ Tweed Tay Lỡ', variant: 'Đen / Size M', received: 15, defect: 0, increase: 15 },
                    { sku: 'PNT-CRM-S', name: 'Quần Âu Ống Suông Lưng Cao', variant: 'Kem / Size S', received: 10, defect: 0, increase: 10 }
