        var currentActiveSlipCode = null;

        function openImportDetail(code) {
            var slip = importSlipsDatabase[code];
            if (!slip) {
                slip = {
                    code: code,
                    supplier: 'Nhà cung cấp đối tác',
                    refDoc: 'HD-VAT-001',
                    receiveDate: '10/10/2026',
                    createDate: '10/10/2026',
                    creator: 'Lê Minh Nhật',
                    status: 'pending',
                    notes: 'Phiếu nhập đối chiếu thực tế.',
                    totalReceived: 10,
                    totalDefect: 0,
                    items: [
                        { sku: 'BLZ-BE-M', name: 'Áo Blazer Linen Signature', variant: 'Be / Size M', received: 10, defect: 0, increase: 10 }
                    ]
                };
                importSlipsDatabase[code] = slip;
            }

            currentActiveSlipCode = code;

            // Đổ dữ liệu khung đầu & đối tác
            document.getElementById('n11SlipCode').innerText = slip.code;
            document.getElementById('n11Creator').innerText = slip.creator;
            document.getElementById('n11CreateDate').innerText = slip.createDate;
            document.getElementById('n11Supplier').innerText = slip.supplier;
            document.getElementById('n11RefDoc').innerText = slip.refDoc;
            document.getElementById('n11ReceiveDate').innerText = slip.receiveDate;
            document.getElementById('n11Notes').innerText = slip.notes || 'Không có ghi chú.';

            // Đổ tổng số
            var totalAvail = slip.totalReceived - slip.totalDefect;
            document.getElementById('n11TotalReceived').innerText = slip.totalReceived + ' cái';
            document.getElementById('n11TotalDefect').innerText = slip.totalDefect + ' cái';
            document.getElementById('n11TotalAvailIncrease').innerText = '+' + totalAvail + ' cái';

            // Đổ bảng hàng hóa
            var tbody = document.getElementById('n11ItemTableBody');
            tbody.innerHTML = '';
            slip.items.forEach(function(it) {
                var tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><span class="font-monospace fw-bold text-dark">${it.sku}</span></td>
                    <td><div class="fw-semibold text-dark">${it.name}</div></td>
                    <td><span class="badge bg-light text-dark border">${it.variant}</span></td>
                    <td class="text-center fw-bold">${it.received}</td>
                    <td class="text-center ${it.defect > 0 ? 'text-danger fw-bold' : 'text-muted'}">${it.defect}</td>
                    <td class="text-center bg-light"><span class="badge bg-success-subtle text-success border border-success-subtle fw-bold">+${it.increase} cái</span></td>
                `;
                tbody.appendChild(tr);
