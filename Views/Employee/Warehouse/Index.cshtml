        function calcImportTotals() {
            var totalRec = 0;
            var totalDef = 0;
            document.querySelectorAll('#importItemTableBody .inp-qty-receive').forEach(function(inp) {
                totalRec += Number(inp.value || 0);
            });
            document.querySelectorAll('#importItemTableBody .inp-qty-defect').forEach(function(inp) {
                totalDef += Number(inp.value || 0);
            });
            document.getElementById('totalReceiveDisplay').innerText = totalRec + ' sản phẩm';
            document.getElementById('totalDefectDisplay').innerText = totalDef + ' cái';
        }

