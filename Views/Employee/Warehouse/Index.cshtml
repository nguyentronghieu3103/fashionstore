            if (btnEl) btnEl.classList.add('active');

            var rows = document.querySelectorAll('#slipTableBody .slip-row');
            rows.forEach(function(r) {
                if (type === 'all' || r.dataset.type === type) {
                    r.classList.remove('d-none');
                } else {
                    r.classList.add('d-none');
                }
            });
        }

        function filterSlipTab(type) {
            var btns = document.querySelectorAll('#slipFilterTabs .nav-link');
            var idx = (type === 'import' ? 1 : type === 'export' ? 2 : type === 'audit' ? 3 : 0);
            if (btns[idx]) applySlipTab(type, btns[idx]);
