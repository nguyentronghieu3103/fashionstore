                alertRej.classList.add('d-none');
                btnGroup.classList.remove('d-none');
                lockedNotice.classList.add('d-none');
                notesInputGroup.classList.remove('d-none');
                document.getElementById('btnExecuteBookStock').innerHTML = '<i class="fa-solid fa-check-double me-1"></i>Duyệt & Ghi sổ kho';
