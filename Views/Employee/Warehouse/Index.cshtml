        function submitImportSlipForReview() {
            // Kiểm tra trùng SKU
            var skuSelects = document.querySelectorAll('#importItemTableBody .sku-selector');
            var skuSet = new Set();
            var hasDuplicate = false;
            skuSelects.forEach(function(s) {
                if (skuSet.has(s.value)) {
                    hasDuplicate = true;
                }
                skuSet.add(s.value);
            });

