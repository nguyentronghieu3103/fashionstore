            // Cập nhật trạng thái & giao diện nút
            var badgeEl = document.getElementById('n11StatusBadge');
            var alertComp = document.getElementById('n11CompletedAlert');
            var alertRej = document.getElementById('n11RejectedAlert');
            var btnGroup = document.getElementById('n11ActionButtonsGroup');
            var lockedNotice = document.getElementById('n11LockedNotice');
            var notesInputGroup = document.getElementById('n11NotesInputGroup');
            var approvedLog = document.getElementById('n11ApprovedLog');

