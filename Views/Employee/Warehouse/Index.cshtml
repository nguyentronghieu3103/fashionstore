                badgeEl.className = 'badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6';
                badgeEl.innerText = 'Đã ghi sổ kho';
                alertComp.classList.remove('d-none');
                alertRej.classList.add('d-none');
                btnGroup.classList.add('d-none');
                lockedNotice.classList.remove('d-none');
                notesInputGroup.classList.add('d-none');
                approvedLog.innerHTML = '<i class="fa-regular fa-circle-check text-success"></i><span><strong>09:40 10/10/2026:</strong> Quản lý ghi sổ kho thành công, đã cộng tồn vào hệ thống.</span>';
            } else if (slip.status === 'draft') {
                badgeEl.className = 'badge bg-secondary-subtle text-secondary border px-3 py-2 fs-6';
