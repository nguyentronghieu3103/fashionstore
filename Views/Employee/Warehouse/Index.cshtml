@section Scripts {
    <script>
        // Chuyển đổi giữa 3 view: tasks (Công việc kho), stock (Tra cứu tồn kho), imports (Phiếu nhập)
        function switchWarehouseView(targetView) {
            var vN08 = document.getElementById('view-n08-section');
            var vStock = document.getElementById('view-stock-section');
            var vImports = document.getElementById('view-imports-section');
            var vDetail = document.getElementById('view-import-detail-section');

            vN08.classList.add('d-none');
            vStock.classList.add('d-none');
            vImports.classList.add('d-none');
            if (vDetail) vDetail.classList.add('d-none');

            if (targetView === 'stock' || targetView === 'n09') {
                vStock.classList.remove('d-none');
                window.history.replaceState(null, '', '?view=stock');
            } else if (targetView === 'imports' || targetView === 'n10') {
                vImports.classList.remove('d-none');
                window.history.replaceState(null, '', '?view=imports');
            } else if (targetView === 'import-detail' || targetView === 'n11') {
                if (vDetail) vDetail.classList.remove('d-none');
                window.history.replaceState(null, '', '?view=import-detail');
            } else {
                vN08.classList.remove('d-none');
                window.history.replaceState(null, '', '?view=tasks');
            }
            window.scrollTo({ top: 0, behavior: 'instant' });
        }

        // Tự động kiểm tra URL khi tải trang
        window.addEventListener('DOMContentLoaded', function() {
            var params = new URLSearchParams(window.location.search);
            var v = params.get('view');
            if (v === 'stock' || v === 'n09') {
                switchWarehouseView('stock');
            } else if (v === 'imports' || v === 'n10') {
                switchWarehouseView('imports');
            } else if (v === 'import-detail' || v === 'n11') {
                openImportDetail('PNK-2026-042');
            } else {
                switchWarehouseView('tasks');
            }
        });

        // ==========================================
        // JS CHO MÀN HÌNH N10 (PHIẾU NHẬP)
        // ==========================================
        function toggleCreateImportForm() {
            var box = document.getElementById('boxCreateImportForm');
            box.classList.toggle('d-none');
            if (!box.classList.contains('d-none')) {
                box.scrollIntoView({ behavior: 'smooth' });
                calcImportTotals();
            }
        }

        function onSkuChange(selectEl) {
            var opt = selectEl.options[selectEl.selectedIndex];
            var color = opt.getAttribute('data-color') || '';
            var size = opt.getAttribute('data-size') || '';
            var row = selectEl.closest('tr');
            var textBadge = row.querySelector('.sku-color-size-text');
            if (textBadge) {
                textBadge.innerText = color + ' / Size ' + size;
            }
            calcImportTotals();
        }

        function addNewItemRow() {
            var tbody = document.getElementById('importItemTableBody');
            var newRow = document.createElement('tr');
            newRow.className = 'import-item-row';
            newRow.innerHTML = `
                <td>
                    <select class="form-select form-select-sm sku-selector" onchange="onSkuChange(this)">
                        <option value="BLZ-BE-M" data-color="Be" data-size="M" selected>BLZ-BE-M - Áo Blazer Linen</option>
                        <option value="BLZ-BE-XS" data-color="Be" data-size="XS">BLZ-BE-XS - Áo Blazer Linen</option>
                        <option value="TWD-BLK-M" data-color="Đen" data-size="M">TWD-BLK-M - Áo Dạ Tweed</option>
                        <option value="DRS-RED-M" data-color="Đỏ rượu" data-size="M">DRS-RED-M - Đầm Lụa Satin</option>
                        <option value="PNT-CRM-S" data-color="Kem" data-size="S">PNT-CRM-S - Quần Âu Ống Suông</option>
                    </select>
                </td>
                <td>
                    <span class="sku-color-size-text badge bg-light text-dark border">Be / Size M</span>
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm text-center fw-bold inp-qty-receive" value="5" min="1" oninput="calcImportTotals()" />
                </td>
                <td>
                    <input type="number" class="form-control form-control-sm text-center inp-qty-defect text-danger" value="0" min="0" oninput="calcImportTotals()" />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm" placeholder="Ghi chú thêm..." />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="removeItemRow(this)">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
