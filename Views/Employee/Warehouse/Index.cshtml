        function executeBookStock() {
            if (!currentActiveSlipCode) return;
            var slip = importSlipsDatabase[currentActiveSlipCode];
            if (!slip) return;

            // Ngoại lệ: Bấm lặp không ghi tăng lần hai
            if (slip.status === 'completed') {
                alert('⚠️ THÔNG BÁO: Phiếu ' + slip.code + ' đã được ghi sổ kho trước đó rồi!\nHệ thống không cho phép bấm lặp ghi tăng lần hai.');
                return;
            }

            var totalAvail = slip.totalReceived - slip.totalDefect;
            var confirmMsg = 'XÁC NHẬN GHI SỔ PHIẾU ' + slip.code + ':\n\n'
                + '- Nhà cung cấp: ' + slip.supplier + '\n'
                + '- Lượng tồn bán được sẽ tăng: +' + totalAvail + ' sản phẩm\n'
                + '- Hàng lỗi phân loại cách ly: ' + slip.totalDefect + ' sản phẩm\n\n'
                + 'Sau khi ghi sổ, phiếu sẽ được khóa hoàn toàn để bảo đảm toàn vẹn số liệu sổ kho. Bạn có chắc chắn muốn ghi sổ?';

            if (!confirm(confirmMsg)) return;

            // Cập nhật trạng thái
            slip.status = 'completed';

            // Cập nhật dòng bảng N10
            var rowEl = document.getElementById('importRow_' + slip.code);
            if (rowEl) {
                rowEl.setAttribute('data-status', 'completed');
                var cell = rowEl.querySelector('.status-cell');
                if (cell) {
                    cell.className = 'badge bg-success-subtle text-success border border-success-subtle status-cell';
                    cell.innerText = 'Đã ghi sổ';
                }
            }

            // Đồng bộ lại màn hình chi tiết
            openImportDetail(slip.code);

            alert('✅ GHI SỔ KHO THÀNH CÔNG:\n\nPhiếu nhập ' + slip.code + ' đã ghi tăng tồn kho chính thức.\nTrạng thái đã chuyển sang "Đã ghi sổ" và đã khóa phiếu.');
        }

        function rejectImportSlip() {
            if (!currentActiveSlipCode) return;
            var slip = importSlipsDatabase[currentActiveSlipCode];
            if (!slip) return;

            if (slip.status === 'completed') {
                alert('Phiếu đã ghi sổ kho, không thể từ chối. Muốn điều chỉnh cần lập chứng từ đảo/điều chỉnh!');
                return;
            }

            var reason = prompt('Nhập lý do từ chối phiếu (VD: Lệch số lượng thực nhận so với hóa đơn):', 'Lệch 2 sản phẩm so với biên bản giao nhận.');
            if (reason === null) return;
            if (!reason.trim()) reason = 'Lệch số lượng thực tế kiểm đếm.';

            slip.status = 'draft';
            document.getElementById('n11RejectReason').innerText = reason;
            document.getElementById('n11RejectedAlert').classList.remove('d-none');

            // Cập nhật bảng N10
            var rowEl = document.getElementById('importRow_' + slip.code);
            if (rowEl) {
                rowEl.setAttribute('data-status', 'draft');
                var cell = rowEl.querySelector('.status-cell');
                if (cell) {
                    cell.className = 'badge bg-secondary-subtle text-secondary border status-cell';
                    cell.innerText = 'Bản nháp (Cần sửa)';
                }
            }

            openImportDetail(slip.code);
            alert('⚠️ Đã trả phiếu về trạng thái "Bản nháp" để nhân viên sửa đổi theo lý do:\n' + reason);
        }

        function printImportSlip() {
            window.print();
        }
