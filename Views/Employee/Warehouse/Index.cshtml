        function applyStockFilters() {
            var kw = (document.getElementById('filterKeyword').value || '').trim().toLowerCase();
            var cat = document.getElementById('filterCategory').value;
            var color = document.getElementById('filterColor').value;
            var size = document.getElementById('filterSize').value;
            var status = document.getElementById('filterStatus').value;

            var rows = document.querySelectorAll('#view-stock-section .stock-row');
            rows.forEach(function(row) {
                var rName = (row.dataset.name || '').toLowerCase();
                var rSku = (row.dataset.sku || '').toLowerCase();
                var rCat = row.dataset.cat || '';
                var rColor = row.dataset.color || '';
                var rSize = row.dataset.size || '';
                var rAvail = Number(row.dataset.avail || 0);
                var rReserved = Number(row.dataset.reserved || 0);
                var rLow = row.dataset.low === 'true';

                var matchKw = !kw || rName.indexOf(kw) !== -1 || rSku.indexOf(kw) !== -1;
                var matchCat = !cat || rCat === cat;
                var matchColor = !color || rColor === color;
                var matchSize = !size || rSize === size;

                var matchStatus = true;
                if (status === 'low') matchStatus = rLow;
                else if (status === 'out') matchStatus = (rAvail === 0);
                else if (status === 'reserved') matchStatus = (rReserved > 0);

                if (matchKw && matchCat && matchColor && matchSize && matchStatus) {
                    row.classList.remove('d-none');
                } else {
                    row.classList.add('d-none');
                }
            });
        }

        function resetStockFilters() {
            document.getElementById('filterKeyword').value = '';
            document.getElementById('filterCategory').value = '';
            document.getElementById('filterColor').value = '';
            document.getElementById('filterSize').value = '';
            document.getElementById('filterStatus').value = '';
            applyStockFilters();
        }

