<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LIGHT LIFE FASHION STUDIO</title>
    
    <!-- FontAwesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- LIGHT LIFE Storefront & Checkout Design System CSS (Thuần CSS3, Không Bootstrap, Không Tailwind, Không Font Serif) -->
    <link rel="stylesheet" href="~/css/lightlife-storefront.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lightlife-checkout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- HEADER TINH GỌN (COMPACT CHECKOUT HEADER) -->
    <header class="ll-checkout-header">
        <div class="ll-container">
            <div class="ll-checkout-header__inner">
                <!-- Logo thương hiệu -->
                <a href="/" class="ll-checkout-header__brand" title="Về trang chủ LIGHT LIFE">
                    <img src="~/images/logo.png" alt="LIGHT LIFE Logo" class="ll-checkout-header__logo" />
                    <div class="ll-checkout-header__brand-text">
                        <span class="ll-checkout-header__brand-title">LIGHT LIFE</span>
                        <span class="ll-checkout-header__brand-sub">FASHION STUDIO</span>
                    </div>
                </a>

                <!-- Huy hiệu bảo mật thanh toán -->
                <div class="ll-checkout-header__security">
                    <i class="fa-solid fa-lock"></i>
                    <span>Thanh toán an toàn (SSL 256-bit)</span>
                </div>

                <!-- Nút quay lại giỏ hàng -->
                <a href="/Cart" class="ll-checkout-header__back-link">
                    <i class="fa-solid fa-arrow-left"></i> Quay lại giỏ hàng
                </a>
            </div>
        </div>
    </header>

    <!-- NỘI DUNG CHÍNH -->
    <main>
        @RenderBody()
    </main>

    <!-- FOOTER TINH GỌN -->
    <footer style="background-color: var(--color-surface); border-top: 1px solid var(--color-border); padding: 1.5rem 0; text-align: center; font-size: 0.8125rem; color: var(--color-text-sub);">
        <div class="ll-container">
            <p style="margin: 0 0 0.35rem 0;">&copy; 2026 LIGHT LIFE FASHION STUDIO. Bảo lưu mọi quyền.</p>
            <p style="margin: 0;">Mọi giao dịch và thông tin thanh toán đều được mã hóa bảo mật theo tiêu chuẩn quốc tế.</p>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="~/js/lightlife-storefront.js" asp-append-version="true"></script>
    <script src="~/js/lightlife-checkout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

