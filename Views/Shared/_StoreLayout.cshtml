<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LIGHT LIFE FASHION STUDIO</title>
    
    <!-- FontAwesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- LIGHT LIFE Storefront Design System CSS (Thuần CSS3, Không Tailwind, Không Font Serif) -->
    <link rel="stylesheet" href="~/css/lightlife-storefront.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- KHUNG 1: HEADER NAVIGATION (Dùng chung cho Storefront) -->
    <header class="ll-header">
        <div class="ll-container">
            <div class="ll-header-inner">
                <!-- 1.1. Logo Thương Hiệu LIGHT LIFE -->
                <a class="ll-brand" href="/" title="LIGHT LIFE - Trang chủ">
                    <img src="~/images/logo.png" alt="LIGHT LIFE Logo" class="ll-brand-img" />
                    <div class="ll-brand-text">
                        <span class="ll-brand-title">LIGHT LIFE</span>
                        <span class="ll-brand-subtitle">FASHION STUDIO</span>
                    </div>
                </a>

                <!-- 1.2. Menu Điều Hướng Chính (Trang chủ, Sản phẩm, Hàng mới, Chính sách) -->
                <nav>
                    <ul class="ll-nav-list">
                        <li>
                            <a href="/" class="ll-nav-link active">
                                <i class="fa-solid fa-house-chimney me-1" style="font-size: 13px;"></i> Trang chủ
                            </a>
                        </li>
                        <li>
                            <a href="/Products" class="ll-nav-link">
                                <i class="fa-solid fa-shirt me-1" style="font-size: 13px;"></i> Sản phẩm
                            </a>
                        </li>
                        <li>
                            <a href="/Products?sort=newest" class="ll-nav-link">
                                <i class="fa-solid fa-sparkles me-1" style="font-size: 13px;"></i> Hàng mới
                            </a>
                        </li>
                        <li>
                            <a href="#policies" class="ll-nav-link">
                                <i class="fa-solid fa-shield-halved me-1" style="font-size: 13px;"></i> Chính sách
                            </a>
                        </li>
                    </ul>
                </nav>

                <!-- 1.3. Khu vực Tiện ích: Tìm kiếm, Giỏ hàng có số lượng & Tài khoản -->
                <div class="ll-header-actions">
                    <!-- Form Tìm kiếm -->
                    <div class="ll-search-wrapper">
                        <form id="llSearchForm" class="ll-search-form" action="/Products" method="get">
                            <input type="text" id="llSearchInput" name="search" class="ll-search-input" placeholder="Tìm trang phục, blazer..." aria-label="Tìm kiếm sản phẩm" />
                            <button type="submit" class="ll-search-btn" title="Tìm kiếm" aria-label="Tìm kiếm">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </button>
                        </form>
                    </div>

                    <!-- Giỏ hàng có badge số lượng (Chưa đăng nhập vẫn xem và thao tác giỏ) -->
                    <a href="/Cart" class="ll-cart-btn" id="llCartBtn" title="Xem giỏ hàng" aria-label="Giỏ hàng">
                        <i class="fa-solid fa-bag-shopping" style="font-size: 18px;"></i>
                        <span class="ll-cart-badge" id="llCartBadge">0</span>
                    </a>

                    <!-- Tài khoản: Chưa đăng nhập hiện nút Đăng nhập; Đã đăng nhập hiện Avatar/Tên + Dropdown -->
                    <div class="ll-auth-area">
                        <!-- Trạng thái CHƯA ĐĂNG NHẬP -->
                        <a href="/Account/Login" class="ll-btn ll-btn-primary ll-btn-sm" id="llLoginBtn">
                            <i class="fa-solid fa-arrow-right-to-bracket"></i> Đăng nhập
                        </a>

                        <!-- Trạng thái ĐÃ ĐĂNG NHẬP (Mặc định ẩn, bật qua auth hook) -->
                        <div class="ll-user-wrapper" id="llUserWrapper" style="display: none;">
                            <button type="button" class="ll-user-btn" onclick="LightLifeAuth.toggleDropdown();" aria-expanded="false" aria-label="Menu tài khoản">
                                <div class="ll-user-avatar" id="llUserAvatar">K</div>
                                <span class="ll-user-name" id="llUserName">Khách hàng</span>
                                <i class="fa-solid fa-angle-down" style="font-size: 11px; color: var(--color-text-sub);"></i>
                            </button>

                            <!-- Dropdown menu tài khoản khách (KHÔNG có dashboard riêng) -->
                            <div class="ll-dropdown-menu" id="llUserDropdownMenu">
                                <a href="/Account/Profile" class="ll-dropdown-item">
                                    <i class="fa-solid fa-user"></i> Tài khoản của tôi
                                </a>
                                <a href="/Account/Orders" class="ll-dropdown-item">
                                    <i class="fa-solid fa-box-open"></i> Đơn hàng của tôi
                                </a>
                                <div class="ll-dropdown-divider"></div>
                                <a href="javascript:void(0)" class="ll-dropdown-item text-danger" onclick="LightLifeAuth.logout();">
                                    <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Nút mở menu trên thiết bị di động -->
                    <button type="button" class="ll-mobile-toggle" id="llMobileToggle" aria-label="Mở menu di động">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>

            <!-- Drawer Menu Di Động -->
            <div class="ll-mobile-nav" id="llMobileNav">
                <a href="/" class="ll-nav-link">Trang chủ</a>
                <a href="/Products" class="ll-nav-link">Sản phẩm</a>
                <a href="/Products?sort=newest" class="ll-nav-link">Hàng mới</a>
                <a href="/Account/Orders" class="ll-nav-link">Đơn hàng của tôi</a>
                <a href="/#policies" class="ll-nav-link">Chính sách</a>
            </div>
        </div>
    </header>

    <!-- MAIN BODY -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- KHUNG 7: FOOTER DÙNG CHUNG (Kế thừa nhận diện Home hiện tại, không có khu vực nội bộ) -->
    <footer class="ll-footer">
        <div class="ll-container">
            <div class="ll-footer-grid">
                <!-- Cột 1: Thông tin thương hiệu -->
                <div>
                    <span class="ll-footer-brand-title">LIGHT LIFE</span>
                    <span class="ll-footer-brand-subtitle">FASHION STUDIO</span>
                    <p class="ll-footer-desc">
                        Thương hiệu thời trang cao cấp Light Life mang đến nguồn cảm hứng thanh lịch, hiện đại với chất liệu tinh tuyển và form dáng chuẩn mực cho mọi khoảnh khắc.
                    </p>
                    <div class="ll-footer-contact">
                        <div class="ll-footer-contact-item">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>123 Đường Thời Trang, Quận 1, TP. Hồ Chí Minh</span>
                        </div>
                        <div class="ll-footer-contact-item">
                            <i class="fa-solid fa-phone"></i>
                            <span>Hotline mua hàng: <strong style="color: #FFFFFF;">1900 6868</strong></span>
                        </div>
                        <div class="ll-footer-contact-item">
                            <i class="fa-solid fa-envelope"></i>
                            <span>Email: cskh@lightlife.vn</span>
                        </div>
                    </div>
                    <div class="ll-footer-socials">
                        <a href="#" class="ll-social-btn" title="Facebook" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="ll-social-btn" title="Instagram" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="ll-social-btn" title="TikTok" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                        <a href="#" class="ll-social-btn" title="YouTube" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>

                <!-- Cột 2: Chính sách & Hỗ trợ -->
                <div>
                    <h4 class="ll-footer-col-title">Chính Sách & Hỗ Trợ</h4>
                    <ul class="ll-footer-links">
                        <li><a href="#policies" class="ll-footer-link"><i class="fa-solid fa-angle-right" style="font-size: 11px;"></i> Giao hàng toàn quốc & COD</a></li>
                        <li><a href="#policies" class="ll-footer-link"><i class="fa-solid fa-angle-right" style="font-size: 11px;"></i> Chính sách đổi trả trong 7 ngày</a></li>
                        <li><a href="#policies" class="ll-footer-link"><i class="fa-solid fa-angle-right" style="font-size: 11px;"></i> Cam kết chất lượng 100%</a></li>
                        <li><a href="#" class="ll-footer-link"><i class="fa-solid fa-angle-right" style="font-size: 11px;"></i> Hướng dẫn chọn size chi tiết</a></li>
                        <li><a href="#" class="ll-footer-link"><i class="fa-solid fa-angle-right" style="font-size: 11px;"></i> Bảo mật thông tin khách hàng</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Về Light Life -->
                <div>
                    <h4 class="ll-footer-col-title">Về Light Life</h4>
                    <ul class="ll-footer-links">
                        <li><a href="#" class="ll-footer-link"><i class="fa-solid fa-angle-right" style="font-size: 11px;"></i> Về chúng tôi</a></li>
                        <li><a href="/Products?sort=newest" class="ll-footer-link"><i class="fa-solid fa-angle-right" style="font-size: 11px;"></i> Bộ sưu tập 2026</a></li>
                        <li><a href="#" class="ll-footer-link"><i class="fa-solid fa-angle-right" style="font-size: 11px;"></i> Hệ thống cửa hàng toàn quốc</a></li>
                        <li><a href="#policies" class="ll-footer-link"><i class="fa-solid fa-angle-right" style="font-size: 11px;"></i> Cam kết dịch vụ khách hàng</a></li>
                    </ul>
                </div>
            </div>

            <!-- Dòng bản quyền -->
            <div class="ll-footer-bottom">
                <span>&copy; 2026 LIGHT LIFE FASHION STUDIO. Bản quyền đã được bảo lưu.</span>
                <span>Thiết kế tiêu chuẩn UI/UX Khách hàng.</span>
            </div>
        </div>
    </footer>

    <!-- LIGHT LIFE Storefront Core JS (Thuần ES6, Không Framework) -->
    <script src="~/js/lightlife-storefront.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

